diff --git a/implementation/engine/pokeemerald/include/atlas_actor_admission.h b/implementation/engine/pokeemerald/include/atlas_actor_admission.h
new file mode 100644
index 0000000000000000000000000000000000000000..f9a40549fdbbd6c8c8973b213dbd9a0e81ad1d1a
--- /dev/null
+++ b/implementation/engine/pokeemerald/include/atlas_actor_admission.h
@@ -0,0 +1,103 @@
+#ifndef GUARD_ATLAS_ACTOR_ADMISSION_H
+#define GUARD_ATLAS_ACTOR_ADMISSION_H
+
+#include "atlas_actor_identity.h"
+
+/* Small transient admission ledger. No field objects, sprites, or save data
+ * are owned by this module. The caller must zero-initialize the roster and
+ * call Reset before its first use. */
+#define ATLAS_ACTOR_ROSTER_CAPACITY 3
+
+enum AtlasActorAdmissionState
+{
+    ATLAS_ACTOR_EMPTY,
+    ATLAS_ACTOR_PENDING,
+    ATLAS_ACTOR_LIVE
+};
+
+/* Native object/sprite slots are transient, never persistent actor identity.
+ * Emerald's object-event failure sentinel is 16 and sprite failure sentinel
+ * is 64. A caller MUST verify both slots are live and owned by this actor
+ * before CommitBound; this pure roster does not read gObjectEvents/gSprites. */
+#define ATLAS_ACTOR_OBJECT_EVENT_LIMIT 16
+#define ATLAS_ACTOR_SPRITE_LIMIT 64
+
+struct AtlasActorNativeBinding
+{
+    u8 objectEventId;
+    u8 spriteId;
+    u8 mapNum;
+    u8 mapGroup;
+};
+
+struct AtlasActorAdmissionSlot
+{
+    struct AtlasActorSpawnKey key;
+    u32 generation;
+    struct AtlasActorNativeBinding binding;
+    u8 localId;
+    u8 state;
+    bool8 bound;
+};
+
+struct AtlasActorAdmissionRoster
+{
+    struct AtlasActorAdmissionSlot slots[ATLAS_ACTOR_ROSTER_CAPACITY];
+};
+
+/* Reset invalidates all handles, including failed/pending reservations.
+ * Call only on a zero-initialized or previously valid roster. */
+void AtlasActorAdmission_Reset(struct AtlasActorAdmissionRoster *roster);
+
+/* freeObjects/freeSprites are fresh native free-slot counts INCLUDING all
+ * pending reservations but EXCLUDING live actors already allocated. Reserve
+ * subtracts outstanding pending reservations to avoid double admission.
+ * reserveObjects/reserveSprites protect non-Atlas owners. No allocation is
+ * performed: the caller MUST revalidate real capacity and successful native
+ * creation before Commit. Birthplace X must be canonical [0, WORLD_WIDTH),
+ * and Y must be inside [-WORLD_HALF_HEIGHT, WORLD_HALF_HEIGHT); latitude
+ * never wraps. Local IDs 0 and 127..255 are deliberately excluded (camera/link/player
+ * namespace); only 1..126 can be admitted. */
+bool8 AtlasActorAdmission_Reserve(struct AtlasActorAdmissionRoster *roster,
+                                  const struct AtlasActorSpawnKey *key,
+                                  u8 localId, u16 freeObjects, u16 freeSprites,
+                                  u16 reserveObjects, u16 reserveSprites,
+                                  struct AtlasActorHandle *out);
+bool8 AtlasActorAdmission_Commit(struct AtlasActorAdmissionRoster *roster,
+                                 struct AtlasActorHandle handle);
+/* Atomically promote PENDING to LIVE with verified native slot IDs.
+ * Reject invalid sentinels and collisions with other LIVE Atlas bindings.
+ * Does not inspect or allocate native objects; caller verifies actual ownership.
+ * Legacy Commit creates an UNBOUND live slot; never use that for cleanup. */
+bool8 AtlasActorAdmission_CommitBound(struct AtlasActorAdmissionRoster *roster,
+                                      struct AtlasActorHandle handle,
+                                      const struct AtlasActorNativeBinding *binding);
+/* A failed lookup invalidates the caller-owned output (16/64 sentinels),
+ * preventing a stale receipt from being reused after culling/retirement.
+ * Output must not alias any internal roster binding; such calls are rejected
+ * without mutation. NULL output is rejected. This is a pure roster lookup,
+ * not proof of native sprite existence or camera-culling reconciliation. */
+bool8 AtlasActorAdmission_ResolveBound(const struct AtlasActorAdmissionRoster *roster,
+                                       struct AtlasActorHandle handle,
+                                       struct AtlasActorNativeBinding *binding);
+/* Call ONLY after the engine has independently confirmed that this exact
+ * native object/sprite was removed (e.g. camera culling). Match a snapshot
+ * captured BEFORE removal, its local/map identity and the actor generation.
+ * This pure roster operation does not inspect or remove engine objects,
+ * set event flags, or prove native removal. Rejects internal receipt aliases
+ * and stale generations, including native slot reuse (ABA).
+ * Camera culling and bulk native removal call through the owned runtime;\n * reset and return-to-field have separate lifecycle contracts. */
+bool8 AtlasActorAdmission_ConfirmNativeRemoval(
+    struct AtlasActorAdmissionRoster *roster,
+    struct AtlasActorHandle handle,
+    const struct AtlasActorNativeBinding *expected,
+    u8 localId);
+bool8 AtlasActorAdmission_Abort(struct AtlasActorAdmissionRoster *roster,
+                                struct AtlasActorHandle handle);
+bool8 AtlasActorAdmission_Retire(struct AtlasActorAdmissionRoster *roster,
+                                 struct AtlasActorHandle handle);
+bool8 AtlasActorAdmission_Resolve(const struct AtlasActorAdmissionRoster *roster,
+                                  struct AtlasActorHandle handle,
+                                  struct AtlasActorSpawnKey *key, u8 *localId);
+
+#endif
diff --git a/implementation/engine/pokeemerald/include/atlas_actor_identity.h b/implementation/engine/pokeemerald/include/atlas_actor_identity.h
new file mode 100644
index 0000000000000000000000000000000000000000..8a79a28e1e1ca3352f7e5b9637c9316b766ed5af
--- /dev/null
+++ b/implementation/engine/pokeemerald/include/atlas_actor_identity.h
@@ -0,0 +1,46 @@
+#ifndef GUARD_ATLAS_ACTOR_IDENTITY_H
+#define GUARD_ATLAS_ACTOR_IDENTITY_H
+
+#include "atlas_world.h"
+
+/* Immutable birthplace identity, independent of map-local event IDs, sprite
+ * slots and the actor's current roaming position. This is a contract only:
+ * no live actor table or persistent state is allocated by this module. */
+struct AtlasActorSpawnKey
+{
+    u32 worldSeed;
+    s32 worldX;
+    s32 worldY;
+    u16 species;
+    u16 generationVersion;
+};
+
+/* A temporary pool reference. Increment the slot's generation whenever an
+ * actor is removed/replaced, including streaming rebases. Never save handles. */
+struct AtlasActorHandle
+{
+    u32 generation;
+    u16 slot;
+};
+
+/* Birthplace latitude is bounded to the physical world. Invalid inputs
+ * fail closed and clear any previously valid output; longitude wraps. */
+bool8 AtlasActor_MakeSpawnKey(struct AtlasActorSpawnKey *out, u32 seed,
+                             s32 worldX, s32 worldY, u16 species, u16 version);
+/* Convert an existing 20x20 map object's local tile into its immutable
+ * world birthplace. Normalize chunk longitude before multiplication, and
+ * reject latitude outside the physical world without wrapping or truncation.
+ * This is a cold-path helper, not a live actor allocation or field hook. */
+bool8 AtlasActor_MakeChunkSpawnKey(struct AtlasActorSpawnKey *out, u32 seed,
+                                  s32 chunkX, s32 chunkY, s32 localX, s32 localY,
+                                  u16 species, u16 version);
+bool8 AtlasActor_SpawnKeyEquals(const struct AtlasActorSpawnKey *a,
+                               const struct AtlasActorSpawnKey *b);
+u32 AtlasActor_NextGeneration(u32 current);
+bool8 AtlasActor_HandleMatches(struct AtlasActorHandle reference,
+                               struct AtlasActorHandle current, u16 capacity);
+
+/* Field object-event binding is intentionally not declared until a native
+ * owner and lifecycle are integrated and verified. */
+
+#endif
diff --git a/implementation/engine/pokeemerald/include/atlas_actor_runtime.h b/implementation/engine/pokeemerald/include/atlas_actor_runtime.h
new file mode 100644
index 0000000000000000000000000000000000000000..04c4d882faf11fe50d79398b6b1b53b3ab3b1cf4
--- /dev/null
+++ b/implementation/engine/pokeemerald/include/atlas_actor_runtime.h
@@ -0,0 +1,64 @@
+#ifndef GUARD_ATLAS_ACTOR_RUNTIME_H
+#define GUARD_ATLAS_ACTOR_RUNTIME_H
+
+#include "atlas_actor_admission.h"
+
+/* Engine-lifetime transient actor owner. The returned address is stable:
+ * never retain a pointer to a caller's stack roster in field callbacks.
+ * GetRoster lazily initializes zeroed EWRAM storage on first use.
+ * This does NOT spawn objects, register callbacks, or save actors. */
+struct AtlasActorAdmissionRoster *AtlasActorRuntime_GetRoster(void);
+
+/* Only call AFTER Emerald has cleared its native object/sprite ownership
+ * during a verified map reset. Invalidates every pending/live generation;
+ * never call while an Atlas-owned native object remains active. No field
+ * Map-load entrypoints call it only after ResumeMap resets sprites and\n * ResetObjectEvents clears native object records; return-to-field does not. */
+void AtlasActorRuntime_ResetAfterNativeClear(void);
+
+/* A camera-cull callback must not lazily create an unused roster. */
+struct AtlasActorAdmissionRoster *AtlasActorRuntime_PeekRoster(void);
+
+/* Snapshot native identity BEFORE culling and confirm only AFTER the
+ * field engine has verified both object and sprite teardown. The receipt
+ * contains a generation: reused native slots cannot retire another actor.
+ * Capture rejects ambiguous LIVE claims to either native object or sprite,
+ * even if one actor otherwise matches the requested map/local identity.
+ * No event flags, sprite allocations, save data, or palette changes here. */
+struct AtlasActorRemovalReceipt
+{
+    struct AtlasActorHandle handle;
+    struct AtlasActorNativeBinding binding;
+    u8 localId;
+};
+bool8 AtlasActorRuntime_CaptureBound(u8 objectEventId, u8 spriteId, u8 localId,
+                                     u8 mapNum, u8 mapGroup,
+                                     struct AtlasActorRemovalReceipt *out);
+bool8 AtlasActorRuntime_ConfirmRemoval(const struct AtlasActorRemovalReceipt *receipt);
+
+/* Bracket synchronous return-to-field recreation after ResetSpriteData.
+ * Begin invalidates pre-reset Atlas sprite claims with sentinel 64; only
+ * freshly verified native sprite IDs may be rebound. */
+bool8 AtlasActorRuntime_BeginSpriteRestore(void);
+void AtlasActorRuntime_EndSpriteRestore(void);
+
+/* Capture a generation-bound object identity with stale sprite sentinel 64
+ * while the phase is active. Reject any duplicate LIVE claim to the same
+ * native object ID, even across different local/map labels. The caller must
+ * still independently verify native object identity before CreateSprite. */
+bool8 AtlasActorRuntime_CaptureForSpriteRestore(u8 objectEventId, u8 localId,
+                                                u8 mapNum, u8 mapGroup,
+                                                struct AtlasActorRemovalReceipt *out);
+/* Commit only after independent native new-sprite ownership verification.
+ * Reject stale generations, changed receipts and fresh-slot collisions. */
+bool8 AtlasActorRuntime_CommitRestoredSprite(const struct AtlasActorRemovalReceipt *receipt,
+                                              u8 newSpriteId);
+
+/* Read-only generation and stale-sprite receipt authorization for cleanup
+ * after failed CreateSprite OR after successful creation but failed rebind.
+ * Not proof of native object/sprite ownership; never remove by slot alone. */
+bool8 AtlasActorRuntime_CanAbandonFailedSpriteRestore(const struct AtlasActorRemovalReceipt *receipt);
+/* Only after independent native teardown/deactivation, retire exactly the
+ * same Atlas generation. No event flags or shared palette ownership here. */
+bool8 AtlasActorRuntime_AbandonFailedSpriteRestore(const struct AtlasActorRemovalReceipt *receipt);
+
+#endif
diff --git a/implementation/engine/pokeemerald/include/atlas_actor_spawn.h b/implementation/engine/pokeemerald/include/atlas_actor_spawn.h
new file mode 100644
index 0000000000000000000000000000000000000000..40b3db72b156f810d7c9600c5194cac8f8136584
--- /dev/null
+++ b/implementation/engine/pokeemerald/include/atlas_actor_spawn.h
@@ -0,0 +1,54 @@
+#ifndef GUARD_ATLAS_ACTOR_SPAWN_H
+#define GUARD_ATLAS_ACTOR_SPAWN_H
+
+#include "atlas_actor_admission.h"
+
+struct ObjectEventTemplate;
+
+/* CLEANUP_BLOCKED means a native object may remain alive: the pending
+ * reservation is deliberately retained for explicit recovery.
+ * ROSTER_FAULT means native creation failed or cleanup succeeded, but
+ * the pending reservation could not be invalidated. Both fail closed. */
+enum AtlasActorSpawnResult
+{
+    ATLAS_ACTOR_SPAWN_REJECTED,
+    ATLAS_ACTOR_SPAWN_ROLLED_BACK,
+    ATLAS_ACTOR_SPAWN_COMMITTED,
+    ATLAS_ACTOR_SPAWN_CLEANUP_BLOCKED,
+    /* Native cleanup is complete (or native creation failed), but the
+     * pending admission could not be invalidated. Do not claim rollback. */
+    ATLAS_ACTOR_SPAWN_ROSTER_FAULT
+};
+
+/* Only for the active Atlas map with zero permanent object templates.
+ * The caller must first Reserve a generation-checked actor and supply a
+ * temporary, non-scripted, non-trainer template with the same local ID.
+ * No world tick invokes this yet. Save/Continue and culling are not wired.
+ * outBinding is invalidated on every non-success return. */
+enum AtlasActorSpawnResult AtlasActorSpawn_TryCommitPending(
+    struct AtlasActorAdmissionRoster *roster,
+    struct AtlasActorHandle handle,
+    struct ObjectEventTemplate *objectTemplate,
+    struct AtlasActorNativeBinding *outBinding);
+
+/* Generation-checked retirement of a LIVE, BOUND transient actor.
+ * No event flags are set. REJECTED means stale/unbound handle;
+ * OWNERSHIP_LOST means current map/object/sprite cannot be proven;
+ * REMOVE_BLOCKED means native flag-free removal refused;
+ * ROSTER_FAULT means native removal succeeded but roster retirement failed.
+ * Only COMPLETED proves both native removal and roster invalidation.
+ * Failure never authorizes blind local-ID removal, retry, or save mutation.
+ * Call before camera culling; culling/transition hooks are NOT wired yet. */
+enum AtlasActorRetireResult
+{
+    ATLAS_ACTOR_RETIRE_REJECTED,
+    ATLAS_ACTOR_RETIRE_OWNERSHIP_LOST,
+    ATLAS_ACTOR_RETIRE_REMOVE_BLOCKED,
+    ATLAS_ACTOR_RETIRE_ROSTER_FAULT,
+    ATLAS_ACTOR_RETIRE_COMPLETED
+};
+
+enum AtlasActorRetireResult AtlasActorSpawn_TryRetireBound(
+    struct AtlasActorAdmissionRoster *roster, struct AtlasActorHandle handle);
+
+#endif
