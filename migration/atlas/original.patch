diff --git a/implementation/engine/pokeemerald/src/atlas_actor_admission.c b/implementation/engine/pokeemerald/src/atlas_actor_admission.c
new file mode 100644
index 0000000000000000000000000000000000000000..731457d170837db9e51872cd1ca0be416cf2e909
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_actor_admission.c
@@ -0,0 +1,243 @@
+#include "global.h"
+#include "atlas_actor_admission.h"
+#include "constants/event_objects.h"
+
+static void ClearSlot(struct AtlasActorAdmissionSlot *slot)
+{
+    slot->key.worldSeed = 0;
+    slot->key.worldX = 0;
+    slot->key.worldY = 0;
+    slot->key.species = 0;
+    slot->key.generationVersion = 0;
+    slot->localId = 0;
+    slot->binding.objectEventId = ATLAS_ACTOR_OBJECT_EVENT_LIMIT;
+    slot->binding.spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    slot->binding.mapNum = 0;
+    slot->binding.mapGroup = 0;
+    slot->bound = FALSE;
+    slot->state = ATLAS_ACTOR_EMPTY;
+    slot->generation = AtlasActor_NextGeneration(slot->generation);
+}
+
+void AtlasActorAdmission_Reset(struct AtlasActorAdmissionRoster *roster)
+{
+    u16 i;
+    if (roster == NULL)
+        return;
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+        ClearSlot(&roster->slots[i]);
+}
+
+static struct AtlasActorAdmissionSlot *FindSlot(struct AtlasActorAdmissionRoster *roster,
+                                                struct AtlasActorHandle handle)
+{
+    struct AtlasActorAdmissionSlot *slot;
+    if (roster == NULL || handle.slot >= ATLAS_ACTOR_ROSTER_CAPACITY)
+        return NULL;
+    slot = &roster->slots[handle.slot];
+    if (!AtlasActor_HandleMatches(handle,
+            (struct AtlasActorHandle){slot->generation, handle.slot},
+            ATLAS_ACTOR_ROSTER_CAPACITY))
+        return NULL;
+    return slot;
+}
+
+bool8 AtlasActorAdmission_Reserve(struct AtlasActorAdmissionRoster *roster,
+                                  const struct AtlasActorSpawnKey *key,
+                                  u8 localId, u16 freeObjects, u16 freeSprites,
+                                  u16 reserveObjects, u16 reserveSprites,
+                                  struct AtlasActorHandle *out)
+{
+    u16 i, pending = 0;
+    u16 vacant = ATLAS_ACTOR_ROSTER_CAPACITY;
+    if (out != NULL)
+    {
+        out->generation = 0;
+        out->slot = ATLAS_ACTOR_ROSTER_CAPACITY;
+    }
+    /* Dynamic Atlas actors must not claim the camera (127), link-player,
+     * or player local-ID namespace. Reserve only 1..126. */
+    if (roster == NULL || key == NULL || out == NULL || localId == 0 || localId >= LOCALID_CAMERA
+     || key->species == 0 || key->generationVersion == 0
+     || key->worldX < 0 || key->worldX >= ATLAS_WORLD_WIDTH
+     || key->worldY < -ATLAS_WORLD_HALF_HEIGHT
+     || key->worldY >= ATLAS_WORLD_HALF_HEIGHT)
+        return FALSE;
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        const struct AtlasActorAdmissionSlot *slot = &roster->slots[i];
+        if (slot->state == ATLAS_ACTOR_EMPTY)
+        {
+            if (vacant == ATLAS_ACTOR_ROSTER_CAPACITY)
+                vacant = i;
+        }
+        else if (slot->state == ATLAS_ACTOR_PENDING || slot->state == ATLAS_ACTOR_LIVE)
+        {
+            if (slot->localId == localId || AtlasActor_SpawnKeyEquals(&slot->key, key))
+                return FALSE;
+            if (slot->state == ATLAS_ACTOR_PENDING)
+                pending++;
+        }
+        else
+            return FALSE;
+    }
+    if (vacant == ATLAS_ACTOR_ROSTER_CAPACITY
+     || (u32)freeObjects <= (u32)reserveObjects + pending
+     || (u32)freeSprites <= (u32)reserveSprites + pending)
+        return FALSE;
+    roster->slots[vacant].generation = AtlasActor_NextGeneration(roster->slots[vacant].generation);
+    roster->slots[vacant].key = *key;
+    roster->slots[vacant].localId = localId;
+    roster->slots[vacant].binding.objectEventId = ATLAS_ACTOR_OBJECT_EVENT_LIMIT;
+    roster->slots[vacant].binding.spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    roster->slots[vacant].binding.mapNum = 0;
+    roster->slots[vacant].binding.mapGroup = 0;
+    roster->slots[vacant].bound = FALSE;
+    roster->slots[vacant].state = ATLAS_ACTOR_PENDING;
+    out->slot = vacant;
+    out->generation = roster->slots[vacant].generation;
+    return TRUE;
+}
+
+bool8 AtlasActorAdmission_Commit(struct AtlasActorAdmissionRoster *roster,
+                                 struct AtlasActorHandle handle)
+{
+    struct AtlasActorAdmissionSlot *slot = FindSlot(roster, handle);
+    if (slot == NULL || slot->state != ATLAS_ACTOR_PENDING)
+        return FALSE;
+    slot->state = ATLAS_ACTOR_LIVE;
+    return TRUE;
+}
+
+/* The native caller must validate actual object/sprite ownership before
+ * passing a binding. This contract only prevents invalid sentinels and
+ * two Atlas actors claiming the same live native slot. */
+bool8 AtlasActorAdmission_CommitBound(struct AtlasActorAdmissionRoster *roster,
+                                      struct AtlasActorHandle handle,
+                                      const struct AtlasActorNativeBinding *binding)
+{
+    struct AtlasActorAdmissionSlot *slot = FindSlot(roster, handle);
+    u16 i;
+    if (slot == NULL || slot->state != ATLAS_ACTOR_PENDING || binding == NULL
+     || binding->objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT
+     || binding->spriteId >= ATLAS_ACTOR_SPRITE_LIMIT)
+        return FALSE;
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        const struct AtlasActorAdmissionSlot *other = &roster->slots[i];
+        if (other != slot && other->state == ATLAS_ACTOR_LIVE && other->bound
+         && (other->binding.objectEventId == binding->objectEventId
+          || other->binding.spriteId == binding->spriteId))
+            return FALSE;
+    }
+    slot->binding = *binding;
+    slot->bound = TRUE;
+    slot->state = ATLAS_ACTOR_LIVE;
+    return TRUE;
+}
+
+bool8 AtlasActorAdmission_ResolveBound(const struct AtlasActorAdmissionRoster *roster,
+                                       struct AtlasActorHandle handle,
+                                       struct AtlasActorNativeBinding *binding)
+{
+    u16 i;
+    /* Output must not alias internal roster storage: a stale lookup must
+     * never corrupt another actor's live binding. */
+    if (binding == NULL)
+        return FALSE;
+    if (roster != NULL)
+    {
+        for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+        {
+            if (binding == &roster->slots[i].binding)
+                return FALSE;
+        }
+    }
+    /* Fail closed: never leave a previously valid object/sprite receipt in
+     * a caller's output after a stale, pending or unbound lookup. */
+    binding->objectEventId = ATLAS_ACTOR_OBJECT_EVENT_LIMIT;
+    binding->spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    binding->mapNum = 0;
+    binding->mapGroup = 0;
+    if (!AtlasActorAdmission_Resolve(roster, handle, NULL, NULL)
+     || !roster->slots[handle.slot].bound)
+        return FALSE;
+    *binding = roster->slots[handle.slot].binding;
+    return TRUE;
+}
+
+/* A camera/removal owner must provide its pre-removal receipt and
+ * generation. Native slot numbers alone are never durable identity. */
+bool8 AtlasActorAdmission_ConfirmNativeRemoval(
+    struct AtlasActorAdmissionRoster *roster,
+    struct AtlasActorHandle handle,
+    const struct AtlasActorNativeBinding *expected,
+    u8 localId)
+{
+    struct AtlasActorAdmissionSlot *slot;
+    u16 i;
+
+    if (expected == NULL || localId == 0 || localId >= LOCALID_CAMERA
+     || expected->objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT
+     || expected->spriteId >= ATLAS_ACTOR_SPRITE_LIMIT)
+        return FALSE;
+    /* The receipt must be an independent snapshot, not a pointer into the
+     * mutable roster. It is NOT itself proof that native removal occurred. */
+    if (roster != NULL)
+    {
+        for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+        {
+            if (expected == &roster->slots[i].binding)
+                return FALSE;
+        }
+    }
+    slot = FindSlot(roster, handle);
+    if (slot == NULL || slot->state != ATLAS_ACTOR_LIVE || !slot->bound
+     || slot->localId != localId
+     || slot->binding.objectEventId != expected->objectEventId
+     || slot->binding.spriteId != expected->spriteId
+     || slot->binding.mapNum != expected->mapNum
+     || slot->binding.mapGroup != expected->mapGroup)
+        return FALSE;
+    ClearSlot(slot);
+    return TRUE;
+}
+
+bool8 AtlasActorAdmission_Abort(struct AtlasActorAdmissionRoster *roster,
+                                struct AtlasActorHandle handle)
+{
+    struct AtlasActorAdmissionSlot *slot = FindSlot(roster, handle);
+    if (slot == NULL || slot->state != ATLAS_ACTOR_PENDING)
+        return FALSE;
+    ClearSlot(slot);
+    return TRUE;
+}
+
+bool8 AtlasActorAdmission_Retire(struct AtlasActorAdmissionRoster *roster,
+                                 struct AtlasActorHandle handle)
+{
+    struct AtlasActorAdmissionSlot *slot = FindSlot(roster, handle);
+    if (slot == NULL || slot->state != ATLAS_ACTOR_LIVE)
+        return FALSE;
+    ClearSlot(slot);
+    return TRUE;
+}
+
+bool8 AtlasActorAdmission_Resolve(const struct AtlasActorAdmissionRoster *roster,
+                                  struct AtlasActorHandle handle,
+                                  struct AtlasActorSpawnKey *key, u8 *localId)
+{
+    const struct AtlasActorAdmissionSlot *slot;
+    if (roster == NULL || handle.slot >= ATLAS_ACTOR_ROSTER_CAPACITY)
+        return FALSE;
+    slot = &roster->slots[handle.slot];
+    if (slot->state != ATLAS_ACTOR_LIVE || !AtlasActor_HandleMatches(handle,
+        (struct AtlasActorHandle){slot->generation, handle.slot},
+        ATLAS_ACTOR_ROSTER_CAPACITY))
+        return FALSE;
+    if (key != NULL)
+        *key = slot->key;
+    if (localId != NULL)
+        *localId = slot->localId;
+    return TRUE;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_actor_identity.c b/implementation/engine/pokeemerald/src/atlas_actor_identity.c
new file mode 100644
index 0000000000000000000000000000000000000000..632f7e53dae0cebb5cdc2a8a4f0207e2ac3b67d4
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_actor_identity.c
@@ -0,0 +1,85 @@
+#include "global.h"
+#include "atlas_actor_identity.h"
+
+bool8 AtlasActor_MakeSpawnKey(struct AtlasActorSpawnKey *out, u32 seed,
+                             s32 worldX, s32 worldY, u16 species, u16 version)
+{
+    if (out == NULL)
+        return FALSE;
+
+    /* Do not leave a previous valid key in a reused output on failure. */
+    out->worldSeed = 0;
+    out->worldX = 0;
+    out->worldY = 0;
+    out->species = 0;
+    out->generationVersion = 0;
+    if (species == 0 || version == 0
+     || worldY < -ATLAS_WORLD_HALF_HEIGHT || worldY >= ATLAS_WORLD_HALF_HEIGHT)
+        return FALSE;
+
+    /* Reduce before adding: even INT_MIN and INT_MAX cannot overflow. */
+    worldX %= ATLAS_WORLD_WIDTH;
+    if (worldX < 0)
+        worldX += ATLAS_WORLD_WIDTH;
+    out->worldSeed = seed;
+    out->worldX = worldX;
+    out->worldY = worldY;
+    out->species = species;
+    out->generationVersion = version;
+    return TRUE;
+}
+
+bool8 AtlasActor_MakeChunkSpawnKey(struct AtlasActorSpawnKey *out, u32 seed,
+                                  s32 chunkX, s32 chunkY, s32 localX, s32 localY,
+                                  u16 species, u16 version)
+{
+    s64 worldY;
+    s32 worldX;
+    if (out == NULL)
+        return FALSE;
+    if (localX < 0 || localX >= ATLAS_CHUNK_SIZE
+     || localY < 0 || localY >= ATLAS_CHUNK_SIZE)
+        return AtlasActor_MakeSpawnKey(out, seed, 0, 0, 0, 0);
+
+    /* Chunk X may be a negative or multi-wrap alias. Multiplying before
+     * canonicalization can overflow even when the tile itself is valid. */
+    chunkX %= ATLAS_WORLD_WIDTH / ATLAS_CHUNK_SIZE;
+    if (chunkX < 0)
+        chunkX += ATLAS_WORLD_WIDTH / ATLAS_CHUNK_SIZE;
+    worldX = chunkX * ATLAS_CHUNK_SIZE + localX;
+
+    /* Signed latitude has no wrap; reject out-of-world birthplaces rather
+     * than creating an identity the actor roster must later refuse. */
+    worldY = (s64)chunkY * ATLAS_CHUNK_SIZE + localY;
+    if (worldY < -ATLAS_WORLD_HALF_HEIGHT || worldY >= ATLAS_WORLD_HALF_HEIGHT)
+        return AtlasActor_MakeSpawnKey(out, seed, 0, 0, 0, 0);
+    return AtlasActor_MakeSpawnKey(out, seed, worldX, (s32)worldY, species, version);
+}
+
+bool8 AtlasActor_SpawnKeyEquals(const struct AtlasActorSpawnKey *a,
+                               const struct AtlasActorSpawnKey *b)
+{
+    return a != NULL && b != NULL
+        && a->species != 0 && b->species != 0
+        && a->generationVersion != 0 && b->generationVersion != 0
+        && a->worldSeed == b->worldSeed
+        && a->worldX == b->worldX
+        && a->worldY == b->worldY
+        && a->species == b->species
+        && a->generationVersion == b->generationVersion;
+}
+
+u32 AtlasActor_NextGeneration(u32 current)
+{
+    current++;
+    return current == 0 ? 1 : current;
+}
+
+bool8 AtlasActor_HandleMatches(struct AtlasActorHandle reference,
+                               struct AtlasActorHandle current, u16 capacity)
+{
+    return reference.generation != 0 && current.generation != 0
+        && reference.slot < capacity && current.slot < capacity
+        && reference.slot == current.slot
+        && reference.generation == current.generation;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_actor_runtime.c b/implementation/engine/pokeemerald/src/atlas_actor_runtime.c
new file mode 100644
index 0000000000000000000000000000000000000000..5860af0d00144a53b294b31f56d62efd7ca16468
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_actor_runtime.c
@@ -0,0 +1,265 @@
+#include "global.h"
+#include "atlas_actor_runtime.h"
+#include "constants/event_objects.h"
+
+/* Stable EWRAM address for all native Atlas actors; no borrowed roster. */
+static EWRAM_DATA struct AtlasActorAdmissionRoster sAtlasActorRoster = {0};
+static EWRAM_DATA bool8 sAtlasActorRosterInitialized = FALSE;
+static EWRAM_DATA bool8 sAtlasSpriteRestoreActive = FALSE;
+
+struct AtlasActorAdmissionRoster *AtlasActorRuntime_GetRoster(void)
+{
+    if (!sAtlasActorRosterInitialized)
+    {
+        AtlasActorAdmission_Reset(&sAtlasActorRoster);
+        sAtlasActorRosterInitialized = TRUE;
+    }
+    return &sAtlasActorRoster;
+}
+
+/* Field removal must not initialize an otherwise unused actor roster. */
+struct AtlasActorAdmissionRoster *AtlasActorRuntime_PeekRoster(void)
+{
+    if (!sAtlasActorRosterInitialized)
+        return NULL;
+    return &sAtlasActorRoster;
+}
+
+void AtlasActorRuntime_ResetAfterNativeClear(void)
+{
+    sAtlasSpriteRestoreActive = FALSE;
+    if (!sAtlasActorRosterInitialized)
+        (void)AtlasActorRuntime_GetRoster();
+    else
+        AtlasActorAdmission_Reset(&sAtlasActorRoster);
+}
+
+/* Call ONLY after ResetSpriteData and before return-to-field CreateSprite.
+ * Old sprite IDs have no ownership meaning after the reset. */
+bool8 AtlasActorRuntime_BeginSpriteRestore(void)
+{
+    u16 i;
+
+    if (!sAtlasActorRosterInitialized || sAtlasSpriteRestoreActive)
+        return FALSE;
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        struct AtlasActorAdmissionSlot *slot = &sAtlasActorRoster.slots[i];
+        if (slot->state == ATLAS_ACTOR_LIVE && slot->bound)
+            slot->binding.spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    }
+    sAtlasSpriteRestoreActive = TRUE;
+    return TRUE;
+}
+
+void AtlasActorRuntime_EndSpriteRestore(void)
+{
+    sAtlasSpriteRestoreActive = FALSE;
+}
+
+/* Snapshot a matching LIVE binding before native removal; the caller must
+ * independently verify the live native object and sprite before capture. */
+bool8 AtlasActorRuntime_CaptureBound(u8 objectEventId, u8 spriteId, u8 localId,
+                                     u8 mapNum, u8 mapGroup,
+                                     struct AtlasActorRemovalReceipt *out)
+{
+    struct AtlasActorAdmissionRoster *roster = AtlasActorRuntime_PeekRoster();
+    u16 i;
+    u16 found = ATLAS_ACTOR_ROSTER_CAPACITY;
+
+    if (out == NULL)
+        return FALSE;
+    out->handle.slot = ATLAS_ACTOR_ROSTER_CAPACITY;
+    out->handle.generation = 0;
+    out->binding.objectEventId = ATLAS_ACTOR_OBJECT_EVENT_LIMIT;
+    out->binding.spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    out->binding.mapNum = 0;
+    out->binding.mapGroup = 0;
+    out->localId = 0;
+    if (roster == NULL || objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT
+     || spriteId >= ATLAS_ACTOR_SPRITE_LIMIT || localId == 0
+     || localId >= LOCALID_CAMERA)
+        return FALSE;
+
+    /* Native object and sprite slots are globally owned, regardless of
+     * local/map labels. Any other LIVE claim to either native slot makes
+     * removal ambiguous; never select the first matching generation. */
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        const struct AtlasActorAdmissionSlot *slot = &roster->slots[i];
+        if (slot->state != ATLAS_ACTOR_LIVE || !slot->bound)
+            continue;
+        if (slot->binding.objectEventId != objectEventId
+         && slot->binding.spriteId != spriteId)
+            continue;
+        if (found != ATLAS_ACTOR_ROSTER_CAPACITY
+         || slot->localId != localId
+         || slot->binding.objectEventId != objectEventId
+         || slot->binding.spriteId != spriteId
+         || slot->binding.mapNum != mapNum
+         || slot->binding.mapGroup != mapGroup)
+            return FALSE;
+        found = i;
+    }
+    if (found == ATLAS_ACTOR_ROSTER_CAPACITY)
+        return FALSE;
+
+    out->handle.slot = found;
+    out->handle.generation = roster->slots[found].generation;
+    out->binding = roster->slots[found].binding;
+    out->localId = localId;
+    return TRUE;
+}
+
+/* Only the field engine calls this AFTER it has independently confirmed
+ * that the captured object and sprite have both been removed. */
+bool8 AtlasActorRuntime_ConfirmRemoval(const struct AtlasActorRemovalReceipt *receipt)
+{
+    struct AtlasActorAdmissionRoster *roster = AtlasActorRuntime_PeekRoster();
+    if (roster == NULL || receipt == NULL)
+        return FALSE;
+    return AtlasActorAdmission_ConfirmNativeRemoval(roster, receipt->handle,
+                                                    &receipt->binding, receipt->localId);
+}
+
+/* ResetSpriteData destroys sprite records, not object-event records.
+ * Capture a generation-bound old receipt by object identity only; never
+ * dereference the old sprite ID during return-to-field restoration. */
+bool8 AtlasActorRuntime_CaptureForSpriteRestore(u8 objectEventId, u8 localId,
+                                                u8 mapNum, u8 mapGroup,
+                                                struct AtlasActorRemovalReceipt *out)
+{
+    struct AtlasActorAdmissionRoster *roster = AtlasActorRuntime_PeekRoster();
+    u16 i;
+    u16 found = ATLAS_ACTOR_ROSTER_CAPACITY;
+
+    if (out == NULL)
+        return FALSE;
+    out->handle.slot = ATLAS_ACTOR_ROSTER_CAPACITY;
+    out->handle.generation = 0;
+    out->binding.objectEventId = ATLAS_ACTOR_OBJECT_EVENT_LIMIT;
+    out->binding.spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    out->binding.mapNum = 0;
+    out->binding.mapGroup = 0;
+    out->localId = 0;
+    if (!sAtlasSpriteRestoreActive || roster == NULL
+     || objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT
+     || localId == 0 || localId >= LOCALID_CAMERA)
+        return FALSE;
+
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        const struct AtlasActorAdmissionSlot *slot = &roster->slots[i];
+        /* Native object IDs are globally owned. A second LIVE claimant
+         * with another map/local label is still a collision, not a
+         * different actor that can safely receive a restored sprite. */
+        if (slot->state != ATLAS_ACTOR_LIVE || !slot->bound
+         || slot->binding.objectEventId != objectEventId)
+            continue;
+        if (found != ATLAS_ACTOR_ROSTER_CAPACITY
+         || slot->localId != localId
+         || slot->binding.spriteId != ATLAS_ACTOR_SPRITE_LIMIT
+         || slot->binding.mapNum != mapNum
+         || slot->binding.mapGroup != mapGroup)
+            return FALSE;
+        found = i;
+    }
+    if (found == ATLAS_ACTOR_ROSTER_CAPACITY)
+        return FALSE;
+
+    out->handle.slot = found;
+    out->handle.generation = roster->slots[found].generation;
+    out->binding = roster->slots[found].binding;
+    out->localId = localId;
+    return TRUE;
+}
+
+/* The field engine must verify gObjectEvents/gSprites independently before
+ * this pure roster mutation. A receipt captured before CreateSprite prevents
+ * stale generations or changed native object identities from being rebound. */
+bool8 AtlasActorRuntime_CommitRestoredSprite(const struct AtlasActorRemovalReceipt *receipt,
+                                              u8 newSpriteId)
+{
+    struct AtlasActorAdmissionRoster *roster = AtlasActorRuntime_PeekRoster();
+    struct AtlasActorNativeBinding current;
+    struct AtlasActorAdmissionSlot *slot;
+    u16 i;
+
+    if (!sAtlasSpriteRestoreActive || roster == NULL || receipt == NULL
+     || newSpriteId >= ATLAS_ACTOR_SPRITE_LIMIT
+     || receipt->handle.slot >= ATLAS_ACTOR_ROSTER_CAPACITY
+     || receipt->localId == 0 || receipt->localId >= LOCALID_CAMERA
+     || receipt->binding.objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT
+     || receipt->binding.spriteId != ATLAS_ACTOR_SPRITE_LIMIT)
+        return FALSE;
+    if (!AtlasActorAdmission_ResolveBound(roster, receipt->handle, &current))
+        return FALSE;
+    slot = &roster->slots[receipt->handle.slot];
+    if (slot->localId != receipt->localId
+     || current.objectEventId != receipt->binding.objectEventId
+     || current.spriteId != receipt->binding.spriteId
+     || current.mapNum != receipt->binding.mapNum
+     || current.mapGroup != receipt->binding.mapGroup)
+        return FALSE;
+
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        const struct AtlasActorAdmissionSlot *other = &roster->slots[i];
+        if (i != receipt->handle.slot && other->state == ATLAS_ACTOR_LIVE
+         && other->bound
+         && (other->binding.spriteId == newSpriteId
+          || other->binding.objectEventId == current.objectEventId))
+            return FALSE;
+    }
+    slot->binding.spriteId = newSpriteId;
+    return TRUE;
+}
+
+/* Read-only generation/identity authorization before removing a freshly
+ * created sprite after failed rebind. This does NOT prove native sprite
+ * ownership: the field caller must independently verify gObjectEvents and
+ * gSprites before flag-free teardown. Another roster's collision cannot
+ * authorize retiring that other generation. */
+bool8 AtlasActorRuntime_CanAbandonFailedSpriteRestore(const struct AtlasActorRemovalReceipt *receipt)
+{
+    struct AtlasActorAdmissionRoster *roster = AtlasActorRuntime_PeekRoster();
+    struct AtlasActorNativeBinding current;
+    const struct AtlasActorAdmissionSlot *slot;
+    u16 i;
+
+    if (!sAtlasSpriteRestoreActive || roster == NULL || receipt == NULL
+     || receipt->handle.slot >= ATLAS_ACTOR_ROSTER_CAPACITY
+     || receipt->localId == 0 || receipt->localId >= LOCALID_CAMERA
+     || receipt->binding.objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT
+     || receipt->binding.spriteId != ATLAS_ACTOR_SPRITE_LIMIT)
+        return FALSE;
+    if (!AtlasActorAdmission_ResolveBound(roster, receipt->handle, &current))
+        return FALSE;
+    slot = &roster->slots[receipt->handle.slot];
+    if (slot->localId != receipt->localId
+     || current.objectEventId != receipt->binding.objectEventId
+     || current.spriteId != ATLAS_ACTOR_SPRITE_LIMIT
+     || current.mapNum != receipt->binding.mapNum
+     || current.mapGroup != receipt->binding.mapGroup)
+        return FALSE;
+
+    /* A second live actor claiming this object makes destructive cleanup
+     * ambiguous, even when the receipt generation itself is valid. */
+    for (i = 0; i < ATLAS_ACTOR_ROSTER_CAPACITY; i++)
+    {
+        const struct AtlasActorAdmissionSlot *other = &roster->slots[i];
+        if (i != receipt->handle.slot && other->state == ATLAS_ACTOR_LIVE
+         && other->bound && other->binding.objectEventId == current.objectEventId)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+/* Call ONLY after the native sprite/object were independently removed, or
+ * after CreateSprite failed and the object record was deactivated. */
+bool8 AtlasActorRuntime_AbandonFailedSpriteRestore(const struct AtlasActorRemovalReceipt *receipt)
+{
+    if (!AtlasActorRuntime_CanAbandonFailedSpriteRestore(receipt))
+        return FALSE;
+    return AtlasActorAdmission_Retire(AtlasActorRuntime_PeekRoster(), receipt->handle);
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_actor_spawn.c b/implementation/engine/pokeemerald/src/atlas_actor_spawn.c
new file mode 100644
index 0000000000000000000000000000000000000000..f59092f18ced52cac4bfabf0adbbe37f786a8fec
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_actor_spawn.c
@@ -0,0 +1,142 @@
+#include "global.h"
+#include "atlas_actor_spawn.h"
+#include "atlas_world.h"
+#include "event_object_movement.h"
+#include "constants/event_objects.h"
+
+static void InvalidateBinding(struct AtlasActorNativeBinding *binding)
+{
+    if (binding != NULL)
+    {
+        binding->objectEventId = ATLAS_ACTOR_OBJECT_EVENT_LIMIT;
+        binding->spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+        binding->mapNum = 0;
+        binding->mapGroup = 0;
+    }
+}
+
+/* Never retire a reservation when native ownership cannot be proven and
+ * cleaned. Blocked cleanup is a hard lifecycle fault, not a retry signal. */
+static enum AtlasActorSpawnResult RollBackSpawn(
+    struct AtlasActorAdmissionRoster *roster,
+    struct AtlasActorHandle handle,
+    u8 objectEventId, u8 localId, u8 mapNum, u8 mapGroup,
+    u8 spriteId)
+{
+    if (!AtlasTryRemoveTransientObjectEvent(objectEventId, localId,
+                                             mapNum, mapGroup, spriteId))
+        return ATLAS_ACTOR_SPAWN_CLEANUP_BLOCKED;
+    if (!AtlasActorAdmission_Abort(roster, handle))
+        return ATLAS_ACTOR_SPAWN_ROSTER_FAULT;
+    return ATLAS_ACTOR_SPAWN_ROLLED_BACK;
+}
+
+enum AtlasActorSpawnResult AtlasActorSpawn_TryCommitPending(
+    struct AtlasActorAdmissionRoster *roster,
+    struct AtlasActorHandle handle,
+    struct ObjectEventTemplate *objectTemplate,
+    struct AtlasActorNativeBinding *outBinding)
+{
+    const struct AtlasActorAdmissionSlot *slot;
+    struct AtlasActorNativeBinding binding;
+    u8 existingObjectId;
+    u8 objectEventId;
+    u8 spriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+    u8 mapNum;
+    u8 mapGroup;
+
+    InvalidateBinding(outBinding);
+    if (roster == NULL || objectTemplate == NULL || gSaveBlock1Ptr == NULL
+     || !AtlasWorld_IsActive() || gMapHeader.events == NULL
+     || gMapHeader.events->objectEventCount != 0
+     || handle.slot >= ATLAS_ACTOR_ROSTER_CAPACITY)
+        return ATLAS_ACTOR_SPAWN_REJECTED;
+
+    slot = &roster->slots[handle.slot];
+    if (slot->state != ATLAS_ACTOR_PENDING
+     || !AtlasActor_HandleMatches(handle,
+            (struct AtlasActorHandle){slot->generation, handle.slot},
+            ATLAS_ACTOR_ROSTER_CAPACITY)
+     || objectTemplate->localId != slot->localId
+     || objectTemplate->kind != OBJ_KIND_NORMAL
+     || objectTemplate->trainerType != 0
+     || objectTemplate->script != NULL || objectTemplate->flagId != 0)
+        return ATLAS_ACTOR_SPAWN_REJECTED;
+
+    mapNum = gSaveBlock1Ptr->location.mapNum;
+    mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    /* TRUE means no matching native object was found. Reject an occupied
+     * local/map identity rather than touching someone else's sprite. */
+    if (!TryGetObjectEventIdByLocalIdAndMap(slot->localId, mapNum,
+                                            mapGroup, &existingObjectId))
+        return ATLAS_ACTOR_SPAWN_REJECTED;
+
+    objectEventId = SpawnSpecialObjectEvent(objectTemplate);
+    if (objectEventId >= ATLAS_ACTOR_OBJECT_EVENT_LIMIT)
+    {
+        /* Emerald deactivates its object slot on CreateSprite failure.
+         * No successful object receipt exists to clean up here. */
+        if (!AtlasActorAdmission_Abort(roster, handle))
+            return ATLAS_ACTOR_SPAWN_ROSTER_FAULT;
+        return ATLAS_ACTOR_SPAWN_ROLLED_BACK;
+    }
+
+    if (!AtlasTryCaptureTransientSpawnReceipt(objectEventId, slot->localId,
+                                               mapNum, mapGroup, &spriteId))
+    {
+        /* Receipt failure may mean ownership changed. Use only the slot's
+         * reported sprite with owner-checked cleanup. If ownership cannot
+         * be proven, retain PENDING and return CLEANUP_BLOCKED. */
+        spriteId = gObjectEvents[objectEventId].spriteId;
+        return RollBackSpawn(roster, handle, objectEventId, slot->localId,
+                             mapNum, mapGroup, spriteId);
+    }
+
+    binding.objectEventId = objectEventId;
+    binding.spriteId = spriteId;
+    binding.mapNum = mapNum;
+    binding.mapGroup = mapGroup;
+    if (!AtlasActorAdmission_CommitBound(roster, handle, &binding))
+        return RollBackSpawn(roster, handle, objectEventId, slot->localId,
+                             mapNum, mapGroup, spriteId);
+
+    if (outBinding != NULL)
+        *outBinding = binding;
+    return ATLAS_ACTOR_SPAWN_COMMITTED;
+}
+
+/* Stage 2B7: retire only a LIVE actor whose generation and native object/sprite
+ * ownership are still verified. A culled or reused slot is NOT evidence that
+ * cleanup completed; the caller must handle that lifecycle separately. */
+enum AtlasActorRetireResult AtlasActorSpawn_TryRetireBound(
+    struct AtlasActorAdmissionRoster *roster, struct AtlasActorHandle handle)
+{
+    struct AtlasActorNativeBinding binding;
+    u8 localId;
+    u8 actualSpriteId = ATLAS_ACTOR_SPRITE_LIMIT;
+
+    if (!AtlasActorAdmission_ResolveBound(roster, handle, &binding)
+     || !AtlasActorAdmission_Resolve(roster, handle, NULL, &localId))
+        return ATLAS_ACTOR_RETIRE_REJECTED;
+
+    /* A stale map transition must never remove a newly reused object slot.
+     * Culling before this call is deliberately NOT treated as cleanup proof. */
+    if (gSaveBlock1Ptr == NULL || !AtlasWorld_IsActive()
+     || gSaveBlock1Ptr->location.mapNum != binding.mapNum
+     || gSaveBlock1Ptr->location.mapGroup != binding.mapGroup
+     || !AtlasTryCaptureTransientSpawnReceipt(binding.objectEventId, localId,
+                                               binding.mapNum, binding.mapGroup,
+                                               &actualSpriteId)
+     || actualSpriteId != binding.spriteId)
+        return ATLAS_ACTOR_RETIRE_OWNERSHIP_LOST;
+
+    if (!AtlasTryRemoveTransientObjectEvent(binding.objectEventId, localId,
+                                             binding.mapNum, binding.mapGroup,
+                                             binding.spriteId))
+        return ATLAS_ACTOR_RETIRE_REMOVE_BLOCKED;
+
+    if (!AtlasActorAdmission_Retire(roster, handle))
+        return ATLAS_ACTOR_RETIRE_ROSTER_FAULT;
+
+    return ATLAS_ACTOR_RETIRE_COMPLETED;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_creation.c b/implementation/engine/pokeemerald/src/atlas_creation.c
new file mode 100644
index 0000000000000000000000000000000000000000..e331722d3cf44fbb59a540706a2f8a716bd0b813
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_creation.c
@@ -0,0 +1,128 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+#include "atlas_geo.h"
+#include "atlas_recipe.h"
+#include "bg.h"
+#include "gpu_regs.h"
+#include "main.h"
+#include "malloc.h"
+#include "menu.h"
+#include "new_game.h"
+#include "overworld.h"
+#include "palette.h"
+#include "sound.h"
+#include "sprite.h"
+#include "string_util.h"
+#include "text.h"
+#include "window.h"
+#include "constants/rgb.h"
+
+EWRAM_DATA u32 gAtlasGenerationFrames = 0;
+EWRAM_DATA u32 gAtlasGenerationStageFrames[ATLAS_PLAN_STAGES] = {0};
+EWRAM_DATA u32 gAtlasGenerationStartFrame = 0;
+EWRAM_DATA u8 gAtlasCreationState = 0;
+static bool8 sRestoring, sFailed;
+static u8 sLastPercent, sLastStage;
+static const struct BgTemplate sBg[] = {{.bg=0, .charBaseIndex=0, .mapBaseIndex=31, .screenSize=0, .paletteMode=0, .priority=0, .baseTile=0}};
+static const struct WindowTemplate sWindows[] = {{.bg=0, .tilemapLeft=1, .tilemapTop=1, .width=28, .height=18, .paletteNum=15, .baseBlock=1}, DUMMY_WIN_TEMPLATE};
+static const u8 sTitle[] = _("ATLAS - CREATING WORLD");
+static const u8 sRestore[] = _("ATLAS - RESTORING WORLD");
+static const u8 sLand[] = _("Outlining land and oceans");
+static const u8 sRanges[] = _("Shaping mountain ranges");
+static const u8 sClimate[] = _("Calculating climate");
+static const u8 sOutlets[] = _("Locating ocean outlets");
+static const u8 sBasins[] = _("Connecting drainage basins");
+static const u8 sRunoff[] = _("Accumulating river runoff");
+static const u8 sIdentity[] = _("Identifying landmasses");
+static const u8 sVerify[] = _("Checking world notes");
+static const u8 sDrainageNames[] = _("Identifying river basins");
+static const u8 sLakes[] = _("Resolving lakes and spillways");
+static const u8 sHabitats[] = _("Deriving seasonal habitats");
+static const u8 sStarting[] = _("Preparing starting terrain");
+static const u8 sFailure[] = _("Not enough free memory.\nRestart the game to retry.");
+static const u8 sSeed[] = _("Seed: ");
+static const u8 sPercent[] = _("%");
+static const u8 sElapsed[] = _("Elapsed seconds: ");
+static const u8 *const sStages[] = {sLand,sRanges,sClimate,sOutlets,sBasins,sRunoff,sDrainageNames,sIdentity,sLakes,sHabitats,sVerify,sStarting};
+static const u8 sColors[] = {0,2,3};
+
+static void VBlank(void) { LoadOam(); ProcessSpriteCopyRequests(); TransferPlttBuffer(); }
+static void Print(u8 y, const u8 *text)
+{
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 2, y, sColors, TEXT_SKIP_DRAW, text);
+}
+static void Draw(void)
+{
+    u8 line[64], *end;
+    u8 stage = AtlasPlan_Stage(), percent = AtlasPlan_Progress();
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    Print(4, sRestoring ? sRestore : sTitle);
+    Print(30, sFailed ? sFailure : sStages[stage > ATLAS_PLAN_STAGES ? ATLAS_PLAN_STAGES : stage]);
+    if (!sFailed)
+    {
+        end = ConvertIntToDecimalStringN(line, percent, STR_CONV_MODE_LEFT_ALIGN, 3);
+        StringCopy(end, sPercent); Print(54, line);
+        FillWindowPixelRect(0, PIXEL_FILL(3), 2, 77, 214, 6);
+        if (percent) FillWindowPixelRect(0, PIXEL_FILL(2), 2, 77, percent * 214 / 100, 6);
+    }
+    end = StringCopy(line, sSeed);
+    ConvertUIntToDecimalStringN(end, gAtlasWorldSeed, STR_CONV_MODE_LEFT_ALIGN, 10); Print(94, line);
+    end = StringCopy(line, sElapsed);
+    ConvertIntToDecimalStringN(end, (gMain.vblankCounter1 - gAtlasGenerationStartFrame) / 60, STR_CONV_MODE_LEFT_ALIGN, 4); Print(114, line);
+    CopyWindowToVram(0, COPYWIN_FULL);
+    sLastPercent = percent; sLastStage = stage;
+}
+static void Run(void)
+{
+    u8 stage = AtlasPlan_Stage();
+    u32 now = gMain.vblankCounter1;
+    if (!sFailed)
+    {
+        if (AtlasPlan_Step(256))
+        {
+            if (!AtlasRecipe_VerifyRestore())
+            {
+                sFailed = !AtlasPlan_Begin(AtlasWorld_ReadSeed());
+                Draw(); return;
+            }
+            if (gAtlasCreationState == 1)
+            {
+                gAtlasGenerationFrames = now - gAtlasGenerationStartFrame;
+                gAtlasCreationState = 2; Draw(); return;
+            }
+            FreeAllWindowBuffers(); SetVBlankCallback(NULL); SetGpuReg(REG_OFFSET_DISPCNT, 0);
+            if (!sRestoring) AtlasWorld_FinishNewGame();
+            else AtlasWorld_RepairLanding();
+            gAtlasGenerationFrames = gMain.vblankCounter1 - gAtlasGenerationStartFrame;
+            gAtlasCreationState = 3; gMain.state = 0;
+            SetMainCallback2(sRestoring ? CB2_ContinueSavedGame : CB2_NewGame);
+            return;
+        }
+        if (stage < ATLAS_PLAN_STAGES) gAtlasGenerationStageFrames[stage]++;
+    }
+    if (sLastPercent != AtlasPlan_Progress() || sLastStage != AtlasPlan_Stage() || now % 60 == 0) Draw();
+}
+static void Begin(bool8 restoring)
+{
+    sRestoring = restoring;
+    SetMainCallback1(NULL); SetVBlankCallback(NULL); StopMapMusic();
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    ResetSpriteData(); ResetPaletteFade(); ResetBgsAndClearDma3BusyFlags(0);
+    InitBgsFromTemplates(0, sBg, 1);
+    ChangeBgX(0, 0, BG_COORD_SET); ChangeBgY(0, 0, BG_COORD_SET);
+    SetGpuReg(REG_OFFSET_BLDCNT, 0); SetGpuReg(REG_OFFSET_WININ, 0); SetGpuReg(REG_OFFSET_WINOUT, 0);
+    memset((void *)VRAM, 0, VRAM_SIZE);
+    if (!restoring) NewGameInitData();
+    AtlasRecipe_Reset();
+    sFailed = !AtlasPlan_Begin(AtlasWorld_ReadSeed());
+    if (restoring && !sFailed) AtlasRecipe_Load(AtlasWorld_ReadSeed());
+    InitWindows(sWindows); DeactivateAllTextPrinters(); PutWindowTilemap(0);
+    LoadPalette(gStandardMenuPalette, BG_PLTT_ID(15), PLTT_SIZE_4BPP);
+    gPlttBufferUnfaded[0] = RGB(31,31,31); gPlttBufferFaded[0] = RGB(31,31,31);
+    gAtlasGenerationStartFrame = gMain.vblankCounter1; gAtlasGenerationFrames = 0;
+    memset(gAtlasGenerationStageFrames, 0, sizeof(gAtlasGenerationStageFrames));
+    gAtlasCreationState = 1; Draw(); ShowBg(0); SetVBlankCallback(VBlank); SetMainCallback2(Run);
+}
+void CB2_AtlasCreateWorld(void) { Begin(FALSE); }
+void CB2_AtlasRestoreWorld(void) { Begin(TRUE); }
diff --git a/implementation/engine/pokeemerald/src/atlas_geo.c b/implementation/engine/pokeemerald/src/atlas_geo.c
new file mode 100644
index 0000000000000000000000000000000000000000..97411fb6304afbcf7dc6d80d41b7192859cff6d8
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_geo.c
@@ -0,0 +1,305 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+#include "atlas_geo.h"
+#include "atlas_tiles.h"
+
+EWRAM_DATA struct AtlasGeoResult gAtlasGeoResult = {0};
+EWRAM_DATA u8 gAtlasGeoStatus = 0;
+EWRAM_DATA static u16 sNext[ATLAS_GEO_COUNT] = {0}, sVisited = 0, sNode = 0, sLastLand = 0, sTrial = 0;
+EWRAM_DATA static u8 sType = 0, sPhase = 0, sDirection = 0, sCheck = 0, sAttempt = 0;
+EWRAM_DATA static s32 sCX = 0, sCY = 0, sWX = 0, sWY = 0, sDX = 0, sDY = 0, sLX = 0, sLY = 0;
+EWRAM_DATA static s32 sMouthDX = 0, sMouthDY = 0;
+EWRAM_DATA static u32 sSeed = 0;
+EWRAM_DATA static bool8 sInitialized = 0;
+EWRAM_DATA static u8 sSceneAt = 0, sSceneWalls = 0, sSceneTarget = 0;
+static s32 Abs(s32 n){return n<0?-n:n;}
+static s32 Wrap(s32 x){x%=ATLAS_WORLD_WIDTH;return x<0?x+ATLAS_WORLD_WIDTH:x;}
+static bool8 ReliefTarget(void){return sType==ATLAS_GEO_MOUNTAIN || sType==ATLAS_GEO_RIDGE || sType==ATLAS_GEO_FOOTHILLS;}
+static bool8 Warm(s32 x,s32 y)
+{
+    u8 i;
+    for(i=0;i<8;i++)if(AtlasWater_Prewarm(x,y))return TRUE;
+    return FALSE;
+}
+static bool8 ReadyPoint(s32 x,s32 y)
+{
+    return Warm(x-1,y-1) && Warm(x+1,y-1) && Warm(x-1,y+1) && Warm(x+1,y+1);
+}
+static bool8 Wet(s32 x,s32 y)
+{
+    struct AtlasCell c;
+    AtlasTerrain_Sample(x,y,&c);
+    return c.waterform==(sType==ATLAS_GEO_LAKE?ATLAS_LAKE:(sType==ATLAS_GEO_RIVER || sType==ATLAS_GEO_VALLEY || sType==ATLAS_GEO_MOUTH || sType==ATLAS_GEO_TRIBUTARY)?ATLAS_RIVER:ATLAS_SEA);
+}
+static void Direction(void)
+{
+    s32 distance = (sType==ATLAS_GEO_RIVER || sType==ATLAS_GEO_VALLEY || sType==ATLAS_GEO_MOUTH || sType==ATLAS_GEO_TRIBUTARY)?512:ATLAS_WORLD_WIDTH/ATLAS_PLAN_WIDTH;
+    if(sType==ATLAS_GEO_MOUTH)sTrial=0;
+    sDX=sCX;sDY=sCY;sWX=sCX;sWY=sCY;
+    if(sDirection==0)sDX+=distance;
+    if(sDirection==1)sDX-=distance;
+    if(sDirection==2)sDY+=distance;
+    if(sDirection==3)sDY-=distance;
+    sPhase=2;
+}
+void AtlasGeo_Begin(u8 type)
+{
+    if(!sInitialized || sSeed!=gAtlasWorldSeed)
+    {
+        u8 i;
+        for(i=0;i<ATLAS_GEO_COUNT;i++)sNext[i]=ATLAS_PLAN_WIDTH*(ATLAS_PLAN_HEIGHT/2)+(gAtlasWorldSeed%ATLAS_PLAN_WIDTH)+i*13;
+        sLastLand=0;sSeed=gAtlasWorldSeed;sInitialized=TRUE;
+    }
+    sType=type;sPhase=0;sVisited=0;sDirection=0;
+    gAtlasGeoStatus=(type<ATLAS_GEO_VOLCANO || type==ATLAS_GEO_RIDGE || type==ATLAS_GEO_VALLEY || type==ATLAS_GEO_FOOTHILLS || type==ATLAS_GEO_MOUTH || type==ATLAS_GEO_TRIBUTARY)?0:3;
+}
+static bool8 Candidate(u16 id)
+{
+    struct AtlasPlanNode *n=&gAtlasPlan[id];
+    if(sType==ATLAS_GEO_LAND)return n->height>125 && n->height<180 && n->continent && n->continent!=sLastLand;
+    if(sType==ATLAS_GEO_MOUNTAIN)return n->height>=195;
+    if(sType==ATLAS_GEO_RIDGE)return n->height>=218;
+    if(sType==ATLAS_GEO_FOOTHILLS)return n->height>=172 && n->height<=184;
+    if(sType==ATLAS_GEO_TRIBUTARY)return AtlasWater_IsTributary(id);
+    if(sType==ATLAS_GEO_MOUTH)return n->height>=ATLAS_PLAN_SEA && n->runoff>=600 && n->parent!=id && n->parent<ATLAS_PLAN_COUNT && gAtlasPlan[n->parent].height<ATLAS_PLAN_SEA;
+    if(sType==ATLAS_GEO_VALLEY)return n->height>=175 && n->runoff>=600 && n->parent!=id;
+    if(sType==ATLAS_GEO_LAKE)return (n->basin&ATLAS_LAKE_FLAG) && n->water>ATLAS_PLAN_SEA && n->water>n->height+2;
+    if(sType==ATLAS_GEO_RIVER)return n->height>=ATLAS_PLAN_SEA && n->runoff>=600 && n->parent!=id;
+    return n->height>=ATLAS_PLAN_SEA && n->height<145;
+}
+u8 AtlasGeo_Step(void)
+{
+    s32 x,y;
+    u8 i;
+    struct AtlasCell c;
+    if(gAtlasGeoStatus)return gAtlasGeoStatus;
+    if(sPhase==0)
+    {
+        for(i=0;i<24;i++)
+        {
+            if(sVisited++>=ATLAS_PLAN_COUNT){gAtlasGeoStatus=2;return 2;}
+            sNode=sNext[sType]++;if(sNext[sType]>=ATLAS_PLAN_COUNT)sNext[sType]=0;
+            if(!Candidate(sNode))continue;
+            sCX=(u32)(sNode%ATLAS_PLAN_WIDTH)*ATLAS_WORLD_WIDTH/ATLAS_PLAN_WIDTH;
+            sCY=(sNode/ATLAS_PLAN_WIDTH)*(2*ATLAS_WORLD_HALF_HEIGHT/(ATLAS_PLAN_HEIGHT-1))-ATLAS_WORLD_HALF_HEIGHT;
+            if(sType==ATLAS_GEO_RIVER || sType==ATLAS_GEO_VALLEY || sType==ATLAS_GEO_MOUTH || sType==ATLAS_GEO_TRIBUTARY){u16 height;AtlasWater_Point(sNode,2,&sCX,&sCY,&height);}
+            if(sType==ATLAS_GEO_MOUTH){sTrial=0;sPhase=11;return 0;}
+            if(ReliefTarget()){sTrial=0;sPhase=sType==ATLAS_GEO_FOOTHILLS?10:6;return 0;}
+            sDirection=0;sPhase=1;return 0;
+        }
+        return 0;
+    }
+    if(sPhase==11)
+    {
+        u8 status=AtlasWater_MouthStep(sNode,&sCX,&sCY,&sMouthDX,&sMouthDY);
+        if(!status)return 0;
+        sPhase=status==1?12:0;return 0;
+    }
+    if(sPhase==12)
+    {
+        if(!Warm(sCX,sCY))return 0;
+        AtlasTerrain_Sample(sCX,sCY,&c);
+        if(c.waterform!=ATLAS_RIVER){sPhase=0;return 0;}
+        sDirection=0;Direction();return 0;
+    }
+    if(sPhase==14)
+    {
+        /* Require both receiving sea and upstream freshwater in the actual
+         * camera rectangle, one resumable point per inspector update. */
+        x=sLX+(s32)(sSceneAt%13)-6;y=sLY+(s32)(sSceneAt/13)-4;
+        if(!Warm(x,y))return 0;
+        AtlasTerrain_Sample(x,y,&c);
+        if(c.waterform==ATLAS_SEA)sSceneWalls=1;
+        if(c.waterform==ATLAS_RIVER)sSceneTarget=1;
+        if(sSceneWalls && sSceneTarget){sPhase=9;return 0;}
+        if(++sSceneAt<117)return 0;
+        if(!sTrial && sSceneTarget && !sSceneWalls)
+        {
+            /* The coast may cross an oblique bank away from the centerline
+             * cut. Follow this dry bank downstream to its receiving shore. */
+            sTrial=1;sWX=sLX;sWY=sLY;
+            sDX=sLX+sMouthDX;sDY=sLY+sMouthDY;
+            sPhase=15;return 0;
+        }
+        if(++sDirection<4)Direction();else sPhase=0;
+        return 0;
+    }
+    if(sPhase==15)
+    {
+        if(!Warm(sDX,sDY))return 0;
+        AtlasTerrain_Sample(sDX,sDY,&c);
+        if(c.waterform==ATLAS_SEA){sPhase=16;return 0;}
+        if(++sDirection<4)Direction();else sPhase=0;
+        return 0;
+    }
+    if(sPhase==16)
+    {
+        if(Abs(sDX-sWX)<=1 && Abs(sDY-sWY)<=1)
+        {
+            sLX=sWX+(sWX>sDX?2:sWX<sDX?-2:0);
+            sLY=sWY+(sWY>sDY?2:sWY<sDY?-2:0);
+            sCheck=0;sAttempt=0;sPhase=4;return 0;
+        }
+        x=sWX+(sDX-sWX)/2;y=sWY+(sDY-sWY)/2;
+        if(!Warm(x,y))return 0;
+        AtlasTerrain_Sample(x,y,&c);
+        if(c.waterform){sDX=x;sDY=y;}else{sWX=x;sWY=y;}
+        return 0;
+    }
+    if(sPhase==1)
+    {
+        if(!Warm(sCX,sCY))return 0;
+        AtlasTerrain_Sample(sCX,sCY,&c);
+        if(sType==ATLAS_GEO_LAND)
+        {
+            if(c.waterform){sPhase=0;return 0;}
+            sLX=sCX;sLY=sCY;sCheck=0;sAttempt=0;sPhase=4;return 0;
+        }
+        if(sType==ATLAS_GEO_COAST)
+        {
+            /* Search for a sea edge around this low coastal candidate. */
+            if(c.waterform){sPhase=0;return 0;}
+            sWX=sCX;sWY=sCY;sDX=sCX+ATLAS_WORLD_WIDTH/ATLAS_PLAN_WIDTH;sDY=sCY;sPhase=5;return 0;
+        }
+        if(!Wet(sCX,sCY)){sPhase=0;return 0;}
+        Direction();return 0;
+    }
+    if(sPhase==5)
+    {
+        if(!Warm(sDX,sDY))return 0;
+        if(!Wet(sDX,sDY))
+        {
+            if(++sDirection>=4){sPhase=0;return 0;}
+            Direction();sPhase=5;return 0;
+        }
+        x=sWX;y=sWY;sWX=sDX;sWY=sDY;sDX=x;sDY=y;sPhase=3;return 0;
+    }
+    if(sPhase==2)
+    {
+        if(!Warm(sDX,sDY))return 0;
+        AtlasTerrain_Sample(sDX,sDY,&c);
+        if(c.waterform)
+        {
+            if(++sDirection>=4){sPhase=0;return 0;}
+            Direction();return 0;
+        }
+        sPhase=3;return 0;
+    }
+    if(sPhase==3)
+    {
+        if(Abs(sDX-sWX)+Abs(sDY-sWY)<=1)
+        {
+            s32 offset=sType==ATLAS_GEO_MOUTH?2:4;
+            sLX=sDX+(sDX>sWX?offset:sDX<sWX?-offset:0);sLY=sDY+(sDY>sWY?offset:sDY<sWY?-offset:0);
+            sCheck=0;sAttempt=0;sPhase=4;return 0;
+        }
+        x=sWX+(sDX-sWX)/2;y=sWY+(sDY-sWY)/2;
+        if(!Warm(x,y))return 0;
+        if(Wet(x,y)){sWX=x;sWY=y;}else{sDX=x;sDY=y;}
+        return 0;
+    }
+    if(sPhase==10)
+    {
+        /* Macro notes are interpolated at runtime. Reject weak/steep regions
+         * before spending thousands of local probes on a missing low contour. */
+        if(!Warm(sCX,sCY))return 0;
+        AtlasTerrain_Sample(sCX,sCY,&c);
+        sPhase=c.waterform || c.elevation<174 || c.elevation>188?0:6;
+        return 0;
+    }
+    if(sPhase==6)
+    {
+        for(i=0;i<32 && sTrial<4096;i++)
+        {
+            u16 trial=sTrial++;
+            x=sCX+((s32)(trial%64)-32)*8;y=sCY+((s32)(trial/64)-32)*8;
+            if(!AtlasMountain_Probe(x,y,sType==ATLAS_GEO_FOOTHILLS?2:sType==ATLAS_GEO_RIDGE))continue;
+            sLX=x;sLY=y;sPhase=7;return 0;
+        }
+        if(sTrial>=4096)sPhase=0;
+        return 0;
+    }
+    if(sPhase==7)
+    {
+        u8 relief;
+        if(!Warm(sLX,sLY))return 0;
+        AtlasTerrain_Sample(sLX,sLY,&c);relief=AtlasMountain_Relief(sLX,sLY,&c);
+        if(c.waterform || (sType==ATLAS_GEO_FOOTHILLS
+            ? ((relief&0x70)!=0x10 || (relief&0x80) || !AtlasMountain_Foothill(sLX,sLY,&c))
+            : (c.elevation<=175 || (sType==ATLAS_GEO_RIDGE?(relief&0x70)!=0x30:!(relief&0x80)))))
+        {sPhase=6;return 0;}
+        sCheck=0;sAttempt=0;sPhase=4;return 0;
+    }
+    if(sPhase==8)
+    {
+        u16 tile;
+        if(sType==ATLAS_GEO_MOUNTAIN && sSceneAt>=22)
+        {
+            /* After the cheap cliff cross-ray filter, look off-axis for
+             * sparse stones, one viewport point per menu update. */
+            u8 at=sSceneAt-22;
+            x=sLX+(s32)(at%13)-6;y=sLY+(s32)(at/13)-4;
+        }
+        else
+        {
+            x=sLX+(sSceneAt<13?(s32)sSceneAt-6:0);
+            y=sLY+(sSceneAt<13?0:(s32)sSceneAt-17);
+        }
+        if(!ReadyPoint(x,y))return 0;
+        tile=AtlasTerrain_Tile(x,y);
+        if((tile&1023)>=924 && (tile&1023)<1018)sSceneWalls++;
+        if(sType==ATLAS_GEO_MOUNTAIN)
+        {
+            u16 id=tile&1023;
+            if(id>=ATLAS_NATURE_PASS_FIRST && id<ATLAS_NATURE_PASS_FIRST+ATLAS_NATURE_PASS_COUNT)sSceneTarget++;
+        }
+        else if(sType==ATLAS_GEO_VALLEY)
+        {AtlasTerrain_Sample(x,y,&c);if(c.waterform==ATLAS_RIVER)sSceneTarget++;}
+        if(sType==ATLAS_GEO_MOUNTAIN && sSceneWalls && sSceneTarget)
+        {sPhase=9;}
+        else
+        {
+            sSceneAt++;
+            if(sSceneAt==22 && !sSceneWalls){sPhase=ReliefTarget()?6:0;return 0;}
+            if(sSceneAt<(sType==ATLAS_GEO_MOUNTAIN?139:22))return 0;
+            if(!sSceneWalls || ((sType==ATLAS_GEO_VALLEY || sType==ATLAS_GEO_MOUNTAIN) && !sSceneTarget))
+            {sPhase=ReliefTarget()?6:0;return 0;}
+        }
+        sPhase=9;
+    }
+    if(sPhase==9)
+    {
+        gAtlasGeoResult.x=Wrap(sLX);gAtlasGeoResult.y=sLY;
+        gAtlasGeoResult.landmass=gAtlasPlan[sNode].continent;gAtlasGeoResult.node=sNode;gAtlasGeoResult.type=sType;
+        if(sType==ATLAS_GEO_LAND)sLastLand=gAtlasGeoResult.landmass;
+        gAtlasGeoStatus=1;return 1;
+    }
+    /* Validate the actual 3x3 walking patch using final art/collision, not
+     * macro classification. Each call yields after one point query. */
+    x=sLX+sCheck%3-1;y=sLY+sCheck/3-1;
+    if(!ReadyPoint(x,y))return 0;
+    if(y<=-ATLAS_WORLD_HALF_HEIGHT+12 || y>=ATLAS_WORLD_HALF_HEIGHT-12 || (AtlasTerrain_Tile(x,y)&0xC00))
+    {
+        if(++sAttempt<4 && sType!=ATLAS_GEO_LAND && !ReliefTarget())
+        {sLX+=sDX>sWX?3:sDX<sWX?-3:0;sLY+=sDY>sWY?3:sDY<sWY?-3:0;sCheck=0;return 0;}
+        if(sType==ATLAS_GEO_MOUTH && ++sDirection<4)Direction();
+        else sPhase=ReliefTarget()?6:0;
+        return 0;
+    }
+    if(++sCheck==9)
+    {
+        if(sType==ATLAS_GEO_MOUTH){sSceneAt=sSceneWalls=sSceneTarget=0;sPhase=14;return 0;}
+        if(ReliefTarget() || sType==ATLAS_GEO_VALLEY)
+        {
+            if(sType==ATLAS_GEO_VALLEY)
+            {
+                AtlasTerrain_Sample(sLX,sLY,&c);
+                if(c.elevation<=175 || c.valley>1){sPhase=0;return 0;}
+            }
+            sSceneAt=sSceneWalls=sSceneTarget=0;sPhase=8;
+        }
+        else sPhase=9;
+    }
+    return gAtlasGeoStatus;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_geo_menu.c b/implementation/engine/pokeemerald/src/atlas_geo_menu.c
new file mode 100644
index 0000000000000000000000000000000000000000..12ffb3a866e526d1c29e23a77e9c56d6c49c9877
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_geo_menu.c
@@ -0,0 +1,128 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+#include "atlas_geo.h"
+#include "bg.h"
+#include "gpu_regs.h"
+#include "main.h"
+#include "menu.h"
+#include "overworld.h"
+#include "field_screen_effect.h"
+#include "palette.h"
+#include "sprite.h"
+#include "string_util.h"
+#include "text.h"
+#include "window.h"
+#include "constants/rgb.h"
+
+static const struct BgTemplate sBg[]={{.bg=0,.charBaseIndex=0,.mapBaseIndex=31,.screenSize=0,.paletteMode=0,.priority=0,.baseTile=0}};
+static const struct WindowTemplate sWindows[]={{.bg=0,.tilemapLeft=1,.tilemapTop=1,.width=27,.height=17,.paletteNum=15,.baseBlock=1},DUMMY_WIN_TEMPLATE};
+static const u8 sTitle[] = _("GEO TP - TERRAIN INSPECTOR");
+static const u8 sLand[] = _("Landmass (continent / island)");
+static const u8 sMountain[] = _("Mountain / natural pass");
+static const u8 sLake[] = _("Lake shore");
+static const u8 sRiver[] = _("River bank");
+static const u8 sCoast[] = _("Coast");
+static const u8 sVolcano[] = _("Volcano - coming soon");
+static const u8 sReturn[] = _("Return to previous location");
+static const u8 sRidge[] = _("Ridge outlook");
+static const u8 sValley[] = _("River valley / terraces");
+static const u8 sFoothills[] = _("Foothills / low ridges");
+static const u8 sMouth[] = _("River mouth");
+static const u8 sTributary[] = _("Tributary / small river");
+static const u8 *const sLabels[]={sLand,sMountain,sLake,sRiver,sCoast,sVolcano,sReturn,sRidge,sValley,sFoothills,sMouth,sTributary};
+static const u8 sX[] = _("X: ");
+static const u8 sY[] = _("  Y: ");
+static const u8 sPage1[] = _("1/2");
+static const u8 sPage2[] = _("2/2");
+static const u8 sArrow[] = _(">");
+static const u8 sHelp[] = _("A: find and go   B: back / cancel");
+static const u8 sSearching[] = _("Searching real terrain...");
+static const u8 sMissing[] = _("No safe landing found. Try again.");
+static const u8 sSoon[] = _("This geography is not generated yet.");
+static const u8 sNoReturn[] = _("No previous teleport in this world.");
+static const u8 sColors[]={1,2,3};
+EWRAM_DATA static u8 sGeoChoice = 0, sMessage = 0;
+EWRAM_DATA static bool8 sSearchingNow = 0, sBookmark = 0;
+EWRAM_DATA static s32 sReturnX = 0, sReturnY = 0;
+EWRAM_DATA static u32 sReturnSeed = 0;
+static void VBlank(void){TransferPlttBuffer();}
+static void Print(u8 x,u8 y,const u8 *text){AddTextPrinterParameterized3(0,FONT_SMALL,x,y,sColors,TEXT_SKIP_DRAW,text);}
+static void Draw(void)
+{
+    u8 i,first=(sGeoChoice/6)*6;
+    u8 line[48],*end;
+    s32 x,y;
+    FillWindowPixelBuffer(0,PIXEL_FILL(1));Print(2,0,sTitle);
+    Print(196,0,first?sPage2:sPage1);
+    for(i=first;i<ATLAS_GEO_COUNT && i<first+6;i++)
+    {Print(14,22+13*(i-first),sLabels[i]);if(i==sGeoChoice)Print(2,22+13*(i-first),sArrow);}
+    AtlasWorld_GetPosition(&x,&y);end=StringCopy(line,sX);
+    end=ConvertIntToDecimalStringN(end,x,STR_CONV_MODE_LEFT_ALIGN,8);
+    end=StringCopy(end,sY);ConvertIntToDecimalStringN(end,y,STR_CONV_MODE_LEFT_ALIGN,9);Print(2,103,line);
+    Print(2,116,sHelp);
+    if(sSearchingNow)Print(2,127,sSearching);
+    else if(sMessage)Print(2,127,sMessage==1?sMissing:sMessage==2?sSoon:sNoReturn);
+    CopyWindowToVram(0,COPYWIN_FULL);
+}
+static void Leave(void)
+{
+    FreeAllWindowBuffers();SetVBlankCallback(NULL);
+    gFieldCallback=FieldCB_ReturnToFieldNoScript;
+    SetMainCallback1(CB1_Overworld);
+    SetMainCallback2(CB2_ReturnToField);
+}
+static void Go(s32 x,s32 y)
+{
+    /* The menu must remain alive if the teleport's latitude gate rejects
+     * a malformed result; teardown before a failed warp would strand UI. */
+    if (y < -ATLAS_WORLD_HALF_HEIGHT || y >= ATLAS_WORLD_HALF_HEIGHT)
+    {
+        sSearchingNow = FALSE;
+        sMessage = 1;
+        Draw();
+        return;
+    }
+    AtlasWorld_GetPosition(&sReturnX,&sReturnY);sReturnSeed=gAtlasWorldSeed;sBookmark=TRUE;
+    FreeAllWindowBuffers();SetVBlankCallback(NULL);
+    AtlasWorld_Teleport(x,y);
+}
+static void GeoMenu_Run(void)
+{
+    if(JOY_NEW(B_BUTTON))
+    {
+        if(sSearchingNow){sSearchingNow=FALSE;Draw();}else Leave();
+        return;
+    }
+    if(sSearchingNow)
+    {
+        u8 status=AtlasGeo_Step();
+        if(status==1){Go(gAtlasGeoResult.x,gAtlasGeoResult.y);return;}
+        if(status){sSearchingNow=FALSE;sMessage=status==3?2:1;Draw();}
+        return;
+    }
+    if(JOY_NEW(DPAD_UP)){sGeoChoice=sGeoChoice?sGeoChoice-1:ATLAS_GEO_COUNT-1;sMessage=0;Draw();}
+    if(JOY_NEW(DPAD_DOWN)){sGeoChoice=(sGeoChoice+1)%ATLAS_GEO_COUNT;sMessage=0;Draw();}
+    if(JOY_NEW(A_BUTTON))
+    {
+        if(sGeoChoice==ATLAS_GEO_RETURN)
+        {
+            if(sBookmark && sReturnSeed==gAtlasWorldSeed){s32 x=sReturnX,y=sReturnY;Go(x,y);return;}
+            sMessage=3;Draw();return;
+        }
+        if(sGeoChoice==ATLAS_GEO_VOLCANO){sMessage=2;Draw();return;}
+        AtlasGeo_Begin(sGeoChoice);sSearchingNow=TRUE;sMessage=0;Draw();
+    }
+}
+void CB2_AtlasGeoMenu(void)
+{
+    SetMainCallback1(NULL);SetVBlankCallback(NULL);SetGpuReg(REG_OFFSET_DISPCNT,0);
+    ResetSpriteData();ResetPaletteFade();ResetBgsAndClearDma3BusyFlags(0);InitBgsFromTemplates(0,sBg,1);
+    ChangeBgX(0,0,BG_COORD_SET);ChangeBgY(0,0,BG_COORD_SET);
+    SetGpuReg(REG_OFFSET_BLDCNT,0);SetGpuReg(REG_OFFSET_WININ,0);SetGpuReg(REG_OFFSET_WINOUT,0);
+    memset((void *)VRAM,0,VRAM_SIZE);
+    InitWindows(sWindows);DeactivateAllTextPrinters();PutWindowTilemap(0);
+    LoadPalette(gStandardMenuPalette,BG_PLTT_ID(15),PLTT_SIZE_4BPP);
+    gPlttBufferUnfaded[0]=RGB(31,31,31);gPlttBufferFaded[0]=RGB(31,31,31);
+    sSearchingNow=FALSE;sMessage=0;Draw();ShowBg(0);SetVBlankCallback(VBlank);SetMainCallback2(GeoMenu_Run);
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_habitat.c b/implementation/engine/pokeemerald/src/atlas_habitat.c
new file mode 100644
index 0000000000000000000000000000000000000000..d6e1ad092bedf735c7a028e17895e5cf2eac0514
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_habitat.c
@@ -0,0 +1,48 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+static u8 Clamp(s32 n) { return n < 0 ? 0 : n > 255 ? 255 : n; }
+EWRAM_DATA static s32 sLatLo = 1, sLatHi = 0, sHeat = 0, sSeason = 0;
+EWRAM_DATA static u32 sKey = 0;
+EWRAM_DATA static struct AtlasHabitat sHabitat = {0};
+EWRAM_DATA static bool8 sValid = 0;
+void AtlasHabitat_Sample(s32 y, u8 elevation, u8 rain, u8 vapor, u8 waterform, struct AtlasHabitat *out)
+{
+    u32 key = elevation | ((u32)rain << 8) | ((u32)vapor << 16) | ((u32)waterform << 24);
+    s32 lat = y < 0 ? -y : y;
+    s32 temperature;
+    s32 moisture, humidity, seasonal;
+    if (sValid && lat >= sLatLo && lat <= sLatHi && sKey == key) { *out = sHabitat; return; }
+    if (lat < sLatLo || lat > sLatHi)
+    {
+        s32 lo, hi;
+        sHeat = lat * 200 / ATLAS_WORLD_HALF_HEIGHT;
+        sSeason = lat * 24 / ATLAS_WORLD_HALF_HEIGHT;
+        /* The intersection of the two exact integer-quotient intervals.
+         * Ceil(q*H/k) through ceil((q+1)*H/k)-1 preserves every boundary;
+         * no latitude rounding or approximate climate is introduced. */
+        sLatLo = (sHeat * ATLAS_WORLD_HALF_HEIGHT + 199) / 200;
+        sLatHi = ((sHeat + 1) * ATLAS_WORLD_HALF_HEIGHT + 199) / 200 - 1;
+        lo = (sSeason * ATLAS_WORLD_HALF_HEIGHT + 23) / 24;
+        hi = ((sSeason + 1) * ATLAS_WORLD_HALF_HEIGHT + 23) / 24 - 1;
+        if (lo > sLatLo) sLatLo = lo;
+        if (hi < sLatHi) sLatHi = hi;
+    }
+    temperature = 238 - sHeat;
+    if (elevation > 145) temperature -= (elevation - 145) * 2;
+    temperature = Clamp(temperature);
+    /* Vapor supply and relative humidity are distinct from precipitation. */
+    humidity = (s32)vapor * 255 / (90 + temperature * 2 / 3);
+    moisture = (rain * 3 + vapor) / 4 - temperature / 12;
+    if (elevation > 170) moisture -= (elevation - 170) / 3;
+    seasonal = 3 + sSeason + (230 - vapor) / 12;
+    if (waterform != ATLAS_DRY)
+    {
+        moisture = 255; humidity += 30; seasonal = seasonal * 2 / 3;
+    }
+    out->temperature = temperature;
+    out->humidity = Clamp(humidity);
+    out->moisture = Clamp(moisture);
+    out->seasonalRange = Clamp(seasonal);
+    sKey = key; sHabitat = *out; sValid = TRUE;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_mountain.c b/implementation/engine/pokeemerald/src/atlas_mountain.c
new file mode 100644
index 0000000000000000000000000000000000000000..ba7227c1885f28b0f21d4944c55d322ae47f375c
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_mountain.c
@@ -0,0 +1,62 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+
+/* Continuous periodic fields, not one independent mound per owner cell.
+ * Macro elevation bounds the relief; existing rivers carve its cross-section.
+ * Tiers are ordinal visual terraces, not metres or native GBA Z codes. */
+static s32 Abs(s32 n){return n<0?-n:n;}
+static s32 ReliefScore(s32 x,s32 y,u8 elevation)
+{
+    s32 local=AtlasTerrain_ReliefNoise(x,y,FALSE),broad=AtlasTerrain_ReliefNoise(x,y,TRUE);
+    s32 height=(128-Abs(local-128))*3/2+(broad-128)/4;
+    /* Continuous amplitude envelope over the existing physical height field.
+     * High uplands retain full strength; plains taper to no raised surface. */
+    if(elevation<205)height=height*(elevation-155)/50;
+    return height;
+}
+u8 AtlasMountain_Relief(s32 x,s32 y,const struct AtlasCell *c)
+{
+    s32 local,broad,height,d;
+    u8 tier,cap;
+    bool8 pass;
+    if(c->waterform!=ATLAS_DRY || c->elevation<=155)return 0;
+    if(c->valley==0)return 0x80;
+    local=AtlasTerrain_ReliefNoise(x,y,FALSE);
+    broad=AtlasTerrain_ReliefNoise(x,y,TRUE);
+    height=(128-Abs(local-128))*3/2+(broad-128)/4;
+    if(c->elevation<205)height=height*(c->elevation-155)/50;
+    tier=height>=160?3:height>=112?2:height>=56?1:0;
+    if(!tier)return 0;
+    /* Broad dry saddles and narrow crest approaches provide connectors.
+     * A connector yields only cliff collision; water is always protected. */
+    d=Abs(broad-128);
+    cap=d<=2?0:d<=5?1:d<=8?2:3;
+    if(tier>cap)tier=cap;
+    if(c->valley<tier)tier=c->valley;
+    pass=Abs(local-128)<=4 || d<=2;
+    return (tier<<4)|(pass?0x80:0);
+}
+bool8 AtlasMountain_Probe(s32 x,s32 y,u8 kind)
+{
+    s32 local=AtlasTerrain_ReliefNoise(x,y,FALSE),broad=AtlasTerrain_ReliefNoise(x,y,TRUE);
+    if(kind)
+    {
+        s32 height=(128-Abs(local-128))*3/2+(broad-128)/4;
+        if(kind==2)return height>=96 && height<=176;
+        return height>=166 && height<=176 && Abs(local-128)>6 && Abs(broad-128)>8;
+    }
+    return Abs(broad-128)<=2 && Abs(local-128)<=28;
+}
+void AtlasMountain_Center(s32 x,s32 y,s32 *cx,s32 *cy)
+{
+    *cx=x;*cy=y;
+}
+
+bool8 AtlasMountain_Foothill(s32 x,s32 y,const struct AtlasCell *c)
+{
+    s32 score;
+    if(c->waterform || c->elevation<168 || c->elevation>189)return FALSE;
+    score=ReliefScore(x,y,c->elevation);
+    return score>=60 && score<=72;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_plan.c b/implementation/engine/pokeemerald/src/atlas_plan.c
new file mode 100644
index 0000000000000000000000000000000000000000..32e0b42fe94a33638d26f837d2c8bb5bbed61eff
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_plan.c
@@ -0,0 +1,428 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+#include "malloc.h"
+
+/* This 54 KiB reservation replaces the same amount of heap, not extra RAM. */
+EWRAM_DATA struct AtlasPlanNode gAtlasPlan[ATLAS_PLAN_COUNT] = {{0}};
+EWRAM_DATA struct AtlasPlanStats gAtlasPlanStats = {0};
+EWRAM_DATA u32 gAtlasWorldSeed = 0;
+EWRAM_DATA bool8 gAtlasPlanReady = FALSE;
+struct PlanScratch {
+    u16 heap[ATLAS_PLAN_COUNT], order[ATLAS_PLAN_COUNT];
+    u8 level[ATLAS_PLAN_COUNT], rain[ATLAS_PLAN_COUNT];
+};
+EWRAM_DATA static struct PlanScratch *sScratch = {0};
+EWRAM_DATA static u16 sAt = 0, sHeapSize = 0, sOrderSize = 0, sFlooded = 0, sQueueHead = 0, sQueueTail = 0;
+EWRAM_DATA static u8 sStage = 0, sRainPass = 0;
+EWRAM_DATA static u16 sWindAt = 0;
+EWRAM_DATA static bool8 sDryRow = 0;
+EWRAM_DATA static bool8 sLabeling = 0;
+EWRAM_DATA static struct AtlasPlanSample sSample = {0};
+EWRAM_DATA static s32 sSampleX0 = 0, sSampleX1 = 0, sSampleY0 = 0, sSampleY1 = 0;
+EWRAM_DATA static bool8 sSampleValid = 0;
+
+void AtlasPlan_ResetSample(void) { sSampleValid = FALSE; }
+
+static u32 Mix(u32 n)
+{
+    n ^= n >> 16; n *= 0x7FEB352D;
+    n ^= n >> 15; n *= 0x846CA68B;
+    return n ^ (n >> 16);
+}
+static u16 Neighbor(u16 id, u8 dir)
+{
+    u16 x = id % ATLAS_PLAN_WIDTH, y = id / ATLAS_PLAN_WIDTH;
+    if (dir == 0) x = (x + 1) % ATLAS_PLAN_WIDTH;
+    if (dir == 1) x = (x + ATLAS_PLAN_WIDTH - 1) % ATLAS_PLAN_WIDTH;
+    if (dir == 2) { if (!y) return id; y--; }
+    if (dir == 3) { if (y == ATLAS_PLAN_HEIGHT - 1) return id; y++; }
+    return y * ATLAS_PLAN_WIDTH + x;
+}
+static bool8 Before(u16 a, u16 b)
+{
+    return sScratch->level[a] < sScratch->level[b]
+        || (sScratch->level[a] == sScratch->level[b] && a < b);
+}
+static void Push(u16 id)
+{
+    u16 at = sHeapSize++;
+    while (at && Before(id, sScratch->heap[(at - 1) / 2]))
+    {
+        sScratch->heap[at] = sScratch->heap[(at - 1) / 2]; at = (at - 1) / 2;
+    }
+    sScratch->heap[at] = id;
+}
+static u16 Pop(void)
+{
+    u16 result = sScratch->heap[0], value = sScratch->heap[--sHeapSize], at = 0, child;
+    while ((child = at * 2 + 1) < sHeapSize)
+    {
+        if (child + 1 < sHeapSize && Before(sScratch->heap[child + 1], sScratch->heap[child])) child++;
+        if (!Before(sScratch->heap[child], value)) break;
+        sScratch->heap[at] = sScratch->heap[child]; at = child;
+    }
+    if (sHeapSize) sScratch->heap[at] = value;
+    return result;
+}
+bool8 AtlasPlan_Begin(u32 seed)
+{
+    AtlasPlan_ResetSample();
+    AtlasStream_Reset();
+    if (sScratch) Free(sScratch);
+    sScratch = AllocZeroed(sizeof(*sScratch));
+    if (!sScratch)
+    {
+        /* The old plan is no longer restartable after its scratch was freed.
+         * Never expose its stale ready/progress state to later consumers. */
+        gAtlasPlanReady = FALSE;
+        sAt = sHeapSize = sOrderSize = sFlooded = sQueueHead = sQueueTail = 0;
+        sStage = sRainPass = 0; sLabeling = FALSE;
+        return FALSE;
+    }
+    memset(gAtlasPlan, 0, sizeof(gAtlasPlan));
+    memset(&gAtlasPlanStats, 0, sizeof(gAtlasPlanStats));
+    gAtlasWorldSeed = gAtlasPlanStats.seed = seed;
+    AtlasTerrain_SetSeed(seed);
+    AtlasWater_Reset();
+    gAtlasPlanReady = FALSE;
+    sAt = sHeapSize = sOrderSize = sFlooded = sQueueHead = sQueueTail = 0;
+    sStage = sRainPass = 0; sLabeling = FALSE;
+    return TRUE;
+}
+static u8 Mountain(u16 id)
+{
+    s32 x = (id % ATLAS_PLAN_WIDTH) * 256, y = (id / ATLAS_PLAN_WIDTH) * 256, best = 0;
+    u32 i;
+    for (i = 0; i < 12; i++)
+    {
+        u32 h = Mix(gAtlasWorldSeed ^ (i * 0x9E3779B1));
+        s32 cx = (h % ATLAS_PLAN_WIDTH) * 256, cy = ((h >> 8) % ATLAS_PLAN_HEIGHT) * 256;
+        s32 dx = x - cx, dy = y - cy, along, across, score;
+        if (dx > ATLAS_PLAN_WIDTH * 128) dx -= ATLAS_PLAN_WIDTH * 256;
+        if (dx < -ATLAS_PLAN_WIDTH * 128) dx += ATLAS_PLAN_WIDTH * 256;
+        /* Slanted bounded range axes, with broad foothills. */
+        if (h & 0x80000000) { along = dx; across = dy - dx / 3; }
+        else { along = dy; across = dx + dy / 3; }
+        if (along < 0) along = -along;
+        if (across < 0) across = -across;
+        score = 65 - across / 10 - along / 35;
+        if (score > best) best = score;
+    }
+    return best;
+}
+static void Advance(void) { sStage++; sAt = 0; }
+bool8 AtlasPlan_ImportHeights(const u8 *heights)
+{
+    u16 i, land = 0;
+    if (!sScratch || sStage || sAt || !heights) return FALSE;
+    for (i = 0; i < ATLAS_PLAN_COUNT; i++)
+        if (heights[i] >= ATLAS_PLAN_SEA) land++;
+    /* Stage 3 has an exceptional forced-ocean correction on all-land worlds.
+     * Their earlier climate cannot be recovered from final heights alone. */
+    if (land == ATLAS_PLAN_COUNT) return FALSE;
+    for (i = 0; i < ATLAS_PLAN_COUNT; i++)
+    {
+        gAtlasPlan[i].height = heights[i];
+        gAtlasPlan[i].rain = 96;
+        gAtlasPlan[i].parent = 0xFFFF;
+    }
+    gAtlasPlanStats.land = land;
+    sStage = 2;
+    return TRUE;
+}
+bool8 AtlasPlan_Step(u16 work)
+{
+    if (gAtlasPlanReady) return TRUE;
+    if (!sScratch) return FALSE;
+    while (work--)
+    {
+        struct AtlasPlanNode *n = &gAtlasPlan[sAt];
+        if (sStage == 0)
+        {
+            struct AtlasCell c;
+            s32 x = (u32)(sAt % ATLAS_PLAN_WIDTH) * ATLAS_WORLD_WIDTH / ATLAS_PLAN_WIDTH;
+            s32 y = (sAt / ATLAS_PLAN_WIDTH) * (2 * ATLAS_WORLD_HALF_HEIGHT / (ATLAS_PLAN_HEIGHT - 1)) - ATLAS_WORLD_HALF_HEIGHT;
+            if (y >= ATLAS_WORLD_HALF_HEIGHT) y = ATLAS_WORLD_HALF_HEIGHT - 1;
+            AtlasTerrain_Sample(x, y, &c);
+            n->height = c.elevation; n->rain = 96; n->parent = 0xFFFF;
+            if (++sAt == ATLAS_PLAN_COUNT) Advance();
+        }
+        else if (sStage == 1)
+        {
+            s32 e = n->height;
+            if (e >= ATLAS_PLAN_SEA) { e += Mountain(sAt); gAtlasPlanStats.land++; }
+            if (e > 255) e = 255;
+            n->height = e;
+            if (++sAt == ATLAS_PLAN_COUNT) Advance();
+        }
+        else if (sStage == 2)
+        {
+            u16 row = sAt / ATLAS_PLAN_WIDTH, upstream;
+            u8 upDir = row < ATLAS_PLAN_HEIGHT / 3 || row >= 2 * ATLAS_PLAN_HEIGHT / 3 ? 0 : 1;
+            s32 rain, rise, precipitation;
+            /* Ocean cells reset vapor to 230. Walking downwind from one ocean
+             * solves the periodic row exactly; an all-land row settles at 12.
+             * This is the same fixed point as WIDTH Jacobi sweeps, in O(WIDTH). */
+            if (sAt % ATLAS_PLAN_WIDTH == 0)
+            {
+                u16 x;
+                sDryRow = TRUE;
+                sWindAt = row * ATLAS_PLAN_WIDTH;
+                for (x = 0; x < ATLAS_PLAN_WIDTH; x++)
+                    if (gAtlasPlan[row * ATLAS_PLAN_WIDTH + x].height < ATLAS_PLAN_SEA)
+                    {
+                        sWindAt = row * ATLAS_PLAN_WIDTH + x;
+                        sDryRow = FALSE;
+                        break;
+                    }
+            }
+            n = &gAtlasPlan[sWindAt];
+            upstream = Neighbor(sWindAt, upDir);
+            rise = (s32)n->height - gAtlasPlan[upstream].height;
+            rain = n->height < ATLAS_PLAN_SEA ? 230 : gAtlasPlan[upstream].humidity - 3;
+            if (n->height >= ATLAS_PLAN_SEA && rise > 0) rain -= rise / 2;
+            if (rain < 12 || sDryRow) rain = 12;
+            precipitation = 35 + rain / 2;
+            if (rise > 0 && n->height >= ATLAS_PLAN_SEA) precipitation += rise;
+            if (row > ATLAS_PLAN_HEIGHT * 2 / 5 && row < ATLAS_PLAN_HEIGHT * 3 / 5) precipitation += 35;
+            if (precipitation > 255) precipitation = 255;
+            n->rain = precipitation;
+            n->humidity = rain;
+            sWindAt = Neighbor(sWindAt, upDir ^ 1);
+            if (++sAt % ATLAS_PLAN_WIDTH == 0) sRainPass++;
+            if (sAt == ATLAS_PLAN_COUNT) Advance();
+        }
+
+        else if (sStage == 3)
+        {
+            sScratch->level[sAt] = n->height < ATLAS_PLAN_SEA ? ATLAS_PLAN_SEA : n->height;
+            if (n->height < ATLAS_PLAN_SEA) { n->parent = sAt; Push(sAt); }
+            if (++sAt == ATLAS_PLAN_COUNT)
+            {
+                /* Extremely land-heavy seeds still have a deterministic ocean. */
+                if (!sHeapSize) { gAtlasPlan[0].height = 0; gAtlasPlan[0].parent = 0; sScratch->level[0] = ATLAS_PLAN_SEA; Push(0); }
+                Advance();
+            }
+        }
+        else if (sStage == 4)
+        {
+            u16 id = Pop();
+            u8 d;
+            sScratch->order[sOrderSize++] = id; sFlooded++;
+            for (d = 0; d < 4; d++)
+            {
+                u16 other = Neighbor(id, d);
+                if (gAtlasPlan[other].parent != 0xFFFF) continue;
+                gAtlasPlan[other].parent = id;
+                sScratch->level[other] = gAtlasPlan[other].height > sScratch->level[id] ? gAtlasPlan[other].height : sScratch->level[id];
+                Push(other);
+            }
+            if (!sHeapSize) Advance();
+        }
+        else if (sStage == 5)
+        {
+            u16 id = sScratch->order[ATLAS_PLAN_COUNT - 1 - sAt], parent = gAtlasPlan[id].parent;
+            u32 runoff = gAtlasPlan[id].runoff;
+            if (gAtlasPlan[id].height >= ATLAS_PLAN_SEA)
+            {
+                runoff += gAtlasPlan[id].rain > 60 ? gAtlasPlan[id].rain - 60 : 1;
+                if (runoff > 65535) runoff = 65535;
+                gAtlasPlan[id].runoff = runoff;
+                if (parent != id)
+                {
+                    runoff += gAtlasPlan[parent].runoff;
+                    gAtlasPlan[parent].runoff = runoff > 65535 ? 65535 : runoff;
+                }
+                if (gAtlasPlan[id].runoff > 600) gAtlasPlanStats.rivers++;
+
+            }
+            if (++sAt == ATLAS_PLAN_COUNT) Advance();
+        }
+        else if (sStage == 6)
+        {
+            u16 id = sScratch->order[sAt], parent = gAtlasPlan[id].parent;
+            struct AtlasPlanNode *node = &gAtlasPlan[id];
+            node->water = sScratch->level[id];
+            if (node->height >= ATLAS_PLAN_SEA)
+            {
+                if (gAtlasPlan[parent].height < ATLAS_PLAN_SEA)
+                {
+                    node->basin = id + 1; gAtlasPlanStats.basins++;
+                }
+                else node->basin = gAtlasPlan[parent].basin & ATLAS_BASIN_MASK;
+                /* Retain wet depressions; a spill level alone does not create a lake. */
+                if (node->water > node->height + 3 && node->runoff > 180 && node->rain > 65)
+                    node->basin |= ATLAS_LAKE_FLAG;
+            }
+            if (++sAt == ATLAS_PLAN_COUNT) { memset(sScratch->rain, 0, sizeof(sScratch->rain)); Advance(); }
+        }
+        else if (sStage == 7)
+        {
+            if (sLabeling)
+            {
+                u16 id = sScratch->heap[sQueueHead++]; u8 d;
+                for (d = 0; d < 4; d++)
+                {
+                    u16 other = Neighbor(id, d);
+                    if (gAtlasPlan[other].height < ATLAS_PLAN_SEA || gAtlasPlan[other].continent) continue;
+                    gAtlasPlan[other].continent = gAtlasPlanStats.continents;
+                    sScratch->heap[sQueueTail++] = other;
+                }
+                if (sQueueHead == sQueueTail) sLabeling = FALSE;
+            }
+            else
+            {
+                if (n->height >= ATLAS_PLAN_SEA && !n->continent)
+                {
+                    n->continent = ++gAtlasPlanStats.continents;
+                    sQueueHead = 0; sQueueTail = 1; sScratch->heap[0] = sAt; sLabeling = TRUE;
+                }
+                if (++sAt == ATLAS_PLAN_COUNT) { if (sLabeling) sAt--; else Advance(); }
+            }
+        }
+        else if (sStage == 8)
+        {
+            if (sLabeling)
+            {
+                u16 id = sScratch->heap[sQueueHead++]; u8 d;
+                for (d = 0; d < 4; d++)
+                {
+                    u16 other = Neighbor(id, d);
+                    if (!(gAtlasPlan[other].basin & ATLAS_LAKE_FLAG) || sScratch->rain[other]
+                        || gAtlasPlan[other].water != gAtlasPlan[id].water) continue;
+                    sScratch->rain[other] = 1; sScratch->heap[sQueueTail++] = other;
+                }
+                if (sQueueHead == sQueueTail) sLabeling = FALSE;
+            }
+            else
+            {
+                if ((n->basin & ATLAS_LAKE_FLAG) && !sScratch->rain[sAt])
+                {
+                    gAtlasPlanStats.lakes++; sScratch->rain[sAt] = 1;
+                    sQueueHead = 0; sQueueTail = 1; sScratch->heap[0] = sAt; sLabeling = TRUE;
+                }
+                if (++sAt == ATLAS_PLAN_COUNT) { if (sLabeling) sAt--; else Advance(); }
+            }
+        }
+        else if (sStage == 9)
+        {
+            struct AtlasHabitat habitat;
+            s32 y = (sAt / ATLAS_PLAN_WIDTH) * (2 * ATLAS_WORLD_HALF_HEIGHT / (ATLAS_PLAN_HEIGHT - 1)) - ATLAS_WORLD_HALF_HEIGHT;
+            u8 waterform = n->height < ATLAS_PLAN_SEA ? ATLAS_SEA : (n->basin & ATLAS_LAKE_FLAG) ? ATLAS_LAKE : ATLAS_DRY;
+            AtlasHabitat_Sample(y, n->height, n->rain, n->humidity, waterform, &habitat);
+            if (n->height >= ATLAS_PLAN_SEA)
+            {
+                if (habitat.temperature < 70) gAtlasPlanStats.cold++;
+                if (habitat.moisture > 155) gAtlasPlanStats.wet++;
+            }
+            gAtlasPlanStats.habitatChecksum = Mix(gAtlasPlanStats.habitatChecksum
+                ^ ((u32)habitat.temperature << 24) ^ ((u32)habitat.humidity << 16)
+                ^ ((u32)habitat.moisture << 8) ^ habitat.seasonalRange);
+            if (++sAt == ATLAS_PLAN_COUNT) Advance();
+        }
+        else
+        {
+            u32 h = gAtlasPlanStats.checksum;
+            h = Mix(h ^ ((u32)n->height << 24) ^ ((u32)n->rain << 16) ^ n->parent);
+            gAtlasPlanStats.checksum = Mix(h ^ n->runoff ^ ((u32)n->continent << 16));
+            gAtlasPlanStats.checksum = Mix(gAtlasPlanStats.checksum ^ n->basin ^ ((u32)n->water << 16) ^ ((u32)n->humidity << 24));
+            if (++sAt == ATLAS_PLAN_COUNT)
+            {
+                Free(sScratch); sScratch = NULL; gAtlasPlanReady = TRUE; sStage = ATLAS_PLAN_STAGES;
+                return TRUE;
+            }
+        }
+    }
+    return FALSE;
+}
+u8 AtlasPlan_Stage(void) { return sStage; }
+u8 AtlasPlan_Progress(void)
+{
+    if (sStage >= ATLAS_PLAN_STAGES) return 100;
+    if (sStage == 0) return (u32)sAt * 7 / ATLAS_PLAN_COUNT;
+    if (sStage == 1) return 7 + (u32)sAt * 7 / ATLAS_PLAN_COUNT;
+    if (sStage == 2) return 14 + sRainPass * 48 / ATLAS_PLAN_HEIGHT;
+    return 62 + (sStage - 3) * 4 + (u32)sAt * 4 / ATLAS_PLAN_COUNT;
+}
+static u8 Blend(u32 a, u32 b, u32 c, u32 d, u32 fx, u32 fy)
+{
+    return ((a * (256 - fx) + b * fx) * (256 - fy)
+        + (c * (256 - fx) + d * fx) * fy) >> 16;
+}
+static void SampleDetail(s32 x, s32 y, struct AtlasPlanSample *sample)
+{
+    u32 sx = (u32)x * ATLAS_PLAN_WIDTH, sy = (u32)(y + ATLAS_WORLD_HALF_HEIGHT) * (ATLAS_PLAN_HEIGHT - 1);
+    u32 col = sx / ATLAS_WORLD_WIDTH, row = sy / (2 * ATLAS_WORLD_HALF_HEIGHT);
+    u32 fx = (sx % ATLAS_WORLD_WIDTH) / (ATLAS_WORLD_WIDTH / 256);
+    u32 fy = (sy % (2 * ATLAS_WORLD_HALF_HEIGHT)) / (2 * ATLAS_WORLD_HALF_HEIGHT / 256);
+    u32 next = (col + 1) % ATLAS_PLAN_WIDTH, lower = row < ATLAS_PLAN_HEIGHT - 1 ? row + 1 : row;
+    struct AtlasPlanNode *a = &gAtlasPlan[row * ATLAS_PLAN_WIDTH + col], *b = &gAtlasPlan[row * ATLAS_PLAN_WIDTH + next];
+    struct AtlasPlanNode *c = &gAtlasPlan[lower * ATLAS_PLAN_WIDTH + col], *d = &gAtlasPlan[lower * ATLAS_PLAN_WIDTH + next];
+    struct AtlasPlanNode *corners[4];
+    u16 ids[4]; u8 k, lake = 0, chosenLevel = ATLAS_PLAN_SEA;
+    u32 nearest = 0xFFFFFFFF; s32 lakeFloor = 255;
+    if (fx > 255) fx = 255;
+    if (fy > 255) fy = 255;
+    /* Exact interval of coordinates with identical integer interpolation
+     * inputs. Lake fitting also depends only on these inputs, not raw x/y. */
+    sSampleX0 = (col * ATLAS_WORLD_WIDTH + fx * (ATLAS_WORLD_WIDTH / 256) + ATLAS_PLAN_WIDTH - 1) / ATLAS_PLAN_WIDTH;
+    sSampleX1 = (col * ATLAS_WORLD_WIDTH + (fx == 255 ? ATLAS_WORLD_WIDTH : (fx + 1) * (ATLAS_WORLD_WIDTH / 256)) + ATLAS_PLAN_WIDTH - 1) / ATLAS_PLAN_WIDTH;
+    sSampleY0 = (row * (2 * ATLAS_WORLD_HALF_HEIGHT) + fy * (2 * ATLAS_WORLD_HALF_HEIGHT / 256) + ATLAS_PLAN_HEIGHT - 2) / (ATLAS_PLAN_HEIGHT - 1) - ATLAS_WORLD_HALF_HEIGHT;
+    sSampleY1 = (row * (2 * ATLAS_WORLD_HALF_HEIGHT) + (fy == 255 ? 2 * ATLAS_WORLD_HALF_HEIGHT : (fy + 1) * (2 * ATLAS_WORLD_HALF_HEIGHT / 256)) + ATLAS_PLAN_HEIGHT - 2) / (ATLAS_PLAN_HEIGHT - 1) - ATLAS_WORLD_HALF_HEIGHT;
+    sample->height = Blend(a->height,b->height,c->height,d->height,fx,fy);
+    sample->rain = Blend(a->rain,b->rain,c->rain,d->rain,fx,fy);
+    sample->humidity = Blend(a->humidity,b->humidity,c->humidity,d->humidity,fx,fy);
+    corners[0]=a;corners[1]=b;corners[2]=c;corners[3]=d;
+    ids[0]=row*ATLAS_PLAN_WIDTH+col;ids[1]=row*ATLAS_PLAN_WIDTH+next;
+    ids[2]=lower*ATLAS_PLAN_WIDTH+col;ids[3]=lower*ATLAS_PLAN_WIDTH+next;
+    /* Flat basin patches; different spill levels cannot overlap as water. */
+    for(k=0;k<4;k++)
+    {
+        struct AtlasPlanNode *n=corners[k];
+        s32 dx=(s32)fx-(k%2?256:0),dy=(s32)fy-(k/2?256:0);
+        s32 depth=(s32)n->water-n->height, radius,rx,ry,floor;
+        u16 other;u32 distance;
+        if(!(n->basin&ATLAS_LAKE_FLAG))continue;
+        radius=64+depth*3;if(radius>112)radius=112;
+        rx=ry=radius;
+        other=Neighbor(ids[k],dx<0?1:0);
+        if((gAtlasPlan[other].basin&ATLAS_LAKE_FLAG)&&gAtlasPlan[other].water==n->water)rx=144;
+        other=Neighbor(ids[k],dy<0?2:3);
+        if((gAtlasPlan[other].basin&ATLAS_LAKE_FLAG)&&gAtlasPlan[other].water==n->water)ry=144;
+        if(dx>rx*5/4||dx<-rx*5/4||dy>ry*5/4||dy<-ry*5/4)continue;
+        distance=(u32)(dx*dx)*65536/(rx*rx)+(u32)(dy*dy)*65536/(ry*ry);
+        if(distance>98304)continue;
+        if(distance<65536)
+        {
+            floor=n->water-depth+(u32)depth*distance/65536;
+            if(!lake||distance<nearest){chosenLevel=n->water;nearest=distance;}
+            if(!lake||floor<lakeFloor)lakeFloor=floor;
+            lake=1;
+        }
+        else if(!lake)
+        {
+            floor=n->water+1;
+            /* Taper the fitted bank into the unmodified surrounding relief. */
+            floor=(floor*(98304-distance)+(u32)sample->height*(distance-65536))/32768;
+            if(distance<nearest){lakeFloor=floor;chosenLevel=n->water;nearest=distance;}
+        }
+    }
+    if(lakeFloor<255 && lakeFloor>sample->height)sample->height=lakeFloor;
+    sample->water=chosenLevel;sample->lake=lake?1:nearest!=0xFFFFFFFF?2:0;
+
+}
+void AtlasPlan_SampleDetail(s32 x, s32 y, struct AtlasPlanSample *sample)
+{
+    if (!sSampleValid || x < sSampleX0 || x >= sSampleX1 || y < sSampleY0 || y >= sSampleY1)
+    {
+        SampleDetail(x, y, &sSample);
+        sSampleValid = TRUE;
+    }
+    *sample = sSample;
+}
+void AtlasPlan_Sample(s32 x, s32 y, u8 *height, u8 *rain)
+{
+    struct AtlasPlanSample s;
+    AtlasPlan_SampleDetail(x,y,&s); *height = s.height; *rain = s.rain;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_pokemon.c b/implementation/engine/pokeemerald/src/atlas_pokemon.c
new file mode 100644
index 0000000000000000000000000000000000000000..6ff11d1acae0bdc28ca9ce228a1e73746984d7c3
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_pokemon.c
@@ -0,0 +1,126 @@
+#include "global.h"
+#include "atlas_pokemon.h"
+#include "constants/event_objects.h"
+#include "constants/species.h"
+
+/* Graphics here are genuine Emerald object-event graphics, NOT battle icons.
+ * Restrict wild scenery to species whose existing sprites fit one map tile
+ * (Poochyena is 32x32). Do not promote unmapped species to lookalikes. */
+#define ATLAS_POKEMON_SPAWN_PER_MILLE 10
+
+static u32 Mix(u32 value)
+{
+    value ^= value >> 16;
+    value *= 0x7FEB352Du;
+    value ^= value >> 15;
+    value *= 0x846CA68Bu;
+    return value ^ (value >> 16);
+}
+
+static u32 PositionHash(s32 x, s32 y, u32 seed)
+{
+    x %= ATLAS_WORLD_WIDTH;
+    if (x < 0)
+        x += ATLAS_WORLD_WIDTH;
+    return Mix(seed ^ (u32)x * 0x9E3779B1u ^ (u32)y * 0x85EBCA77u);
+}
+
+bool8 AtlasPokemon_IsCandidate(s32 x, s32 y, u32 seed)
+{
+    /* Latitude is bounded; longitude remains cyclic. Do not propose
+     * scenery actors beyond either pole, even with a synthetic cell. */
+    if (y < -ATLAS_WORLD_HALF_HEIGHT || y >= ATLAS_WORLD_HALF_HEIGHT)
+        return FALSE;
+    return Mix(PositionHash(x, y, seed) ^ 0xA341316Cu) % 1000 < ATLAS_POKEMON_SPAWN_PER_MILLE;
+}
+
+bool8 AtlasPokemon_Select(s32 x, s32 y, u32 seed, const struct AtlasCell *cell, struct AtlasPokemonSpawn *out)
+{
+    u32 hash, roll;
+    u8 rarity;
+    u16 species = SPECIES_NONE;
+    u8 graphicsId = 0;
+
+    if (out == NULL)
+        return FALSE;
+    out->species = SPECIES_NONE;
+    out->graphicsId = 0;
+    out->rarity = ATLAS_POKEMON_COMMON;
+    if (cell == NULL || y < -ATLAS_WORLD_HALF_HEIGHT
+     || y >= ATLAS_WORLD_HALF_HEIGHT || cell->biome > ATLAS_WETLAND
+     || cell->waterform > ATLAS_LAKE || cell->landform > ATLAS_COAST
+     || cell->waterform != ATLAS_DRY)
+        return FALSE;
+
+    hash = PositionHash(x, y, seed);
+    if (Mix(hash ^ 0xA341316Cu) % 1000 >= ATLAS_POKEMON_SPAWN_PER_MILLE)
+        return FALSE;
+    roll = Mix(hash ^ 0xC8013EA4u) % 1000;
+    rarity = roll < 700 ? ATLAS_POKEMON_COMMON
+           : roll < 920 ? ATLAS_POKEMON_UNCOMMON
+           : roll < 990 ? ATLAS_POKEMON_RARE : ATLAS_POKEMON_VERY_RARE;
+
+    /* Roster is intentionally limited to verified native overworld art.
+     * Don't represent tropical creatures in arctic tundra or place aquatic
+     * species on dry ground. The final biome taxonomy is still research. */
+    if (cell->temperature < 75 || cell->elevation > 195)
+        return FALSE;
+    if (cell->landform == ATLAS_COAST)
+    {
+        if (rarity == ATLAS_POKEMON_COMMON)
+            species = SPECIES_WINGULL, graphicsId = OBJ_EVENT_GFX_WINGULL;
+        else if (rarity == ATLAS_POKEMON_UNCOMMON && cell->moisture >= 105)
+            species = SPECIES_AZURILL, graphicsId = OBJ_EVENT_GFX_AZURILL;
+    }
+    else if (cell->biome == ATLAS_DESERT || cell->moisture < 70)
+    {
+        /* Unmapped desert species: no misleading substitutes. */
+        return FALSE;
+    }
+    else if (cell->biome == ATLAS_WETLAND || cell->moisture >= 180)
+    {
+        if (rarity == ATLAS_POKEMON_COMMON)
+            species = SPECIES_AZURILL, graphicsId = OBJ_EVENT_GFX_AZURILL;
+        else if (rarity == ATLAS_POKEMON_UNCOMMON)
+            species = SPECIES_AZUMARILL, graphicsId = OBJ_EVENT_GFX_AZUMARILL;
+        else if (rarity == ATLAS_POKEMON_RARE && cell->temperature >= 135)
+            species = SPECIES_KECLEON, graphicsId = OBJ_EVENT_GFX_KECLEON;
+    }
+    else if (cell->biome == ATLAS_JUNGLE || cell->biome == ATLAS_FOREST)
+    {
+        if (rarity == ATLAS_POKEMON_COMMON)
+            species = SPECIES_ZIGZAGOON, graphicsId = OBJ_EVENT_GFX_ZIGZAGOON_2;
+        else if (rarity == ATLAS_POKEMON_UNCOMMON)
+            species = SPECIES_SKITTY, graphicsId = OBJ_EVENT_GFX_SKITTY;
+        else if (rarity == ATLAS_POKEMON_RARE && cell->temperature >= 140)
+            species = SPECIES_KECLEON, graphicsId = OBJ_EVENT_GFX_KECLEON;
+        else if (rarity == ATLAS_POKEMON_VERY_RARE && cell->temperature < 185)
+            species = SPECIES_PIKACHU, graphicsId = OBJ_EVENT_GFX_PIKACHU;
+    }
+    else if (cell->biome == ATLAS_SAVANNA || cell->temperature > 190)
+    {
+        if (rarity == ATLAS_POKEMON_COMMON)
+            species = SPECIES_POOCHYENA, graphicsId = OBJ_EVENT_GFX_POOCHYENA;
+        else if (rarity == ATLAS_POKEMON_UNCOMMON)
+            species = SPECIES_ZIGZAGOON, graphicsId = OBJ_EVENT_GFX_ZIGZAGOON_2;
+        else if (rarity == ATLAS_POKEMON_RARE)
+            species = SPECIES_SKITTY, graphicsId = OBJ_EVENT_GFX_SKITTY;
+    }
+    else
+    {
+        if (rarity == ATLAS_POKEMON_COMMON)
+            species = SPECIES_ZIGZAGOON, graphicsId = OBJ_EVENT_GFX_ZIGZAGOON_2;
+        else if (rarity == ATLAS_POKEMON_UNCOMMON)
+            species = SPECIES_POOCHYENA, graphicsId = OBJ_EVENT_GFX_POOCHYENA;
+        else if (rarity == ATLAS_POKEMON_RARE)
+            species = SPECIES_SKITTY, graphicsId = OBJ_EVENT_GFX_SKITTY;
+        else if (rarity == ATLAS_POKEMON_VERY_RARE && cell->moisture >= 110)
+            species = SPECIES_PIKACHU, graphicsId = OBJ_EVENT_GFX_PIKACHU;
+    }
+    if (species == SPECIES_NONE)
+        return FALSE;
+    out->species = species;
+    out->graphicsId = graphicsId;
+    out->rarity = rarity;
+    return TRUE;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_recipe.c b/implementation/engine/pokeemerald/src/atlas_recipe.c
new file mode 100644
index 0000000000000000000000000000000000000000..39d953459645dd291c3aa2c23679e1ad84a218a6
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_recipe.c
@@ -0,0 +1,124 @@
+#include "global.h"
+#include "atlas_plan.h"
+#include "atlas_world.h"
+#include "atlas_recipe.h"
+#include "malloc.h"
+
+/* Explicit little-endian format; no compiler struct padding enters flash.
+ * 128-byte header, 4608 height bytes, 2304 class + 576 policy bytes reserved,
+ * 320 padding bytes. Reserved fields must be zero in codec version 1.
+ * CRC covers both sector payloads with the CRC field treated as zero. */
+EWRAM_DATA u8 gAtlasRecipeStatus = 0;
+EWRAM_DATA u16 gAtlasRecipeWrites = 0;
+EWRAM_DATA static u32 sExpectedPlan = 0, sExpectedHabitat = 0;
+static const u32 sCrc[] = {
+    0x00000000,0x1DB71064,0x3B6E20C8,0x26D930AC,
+    0x76DC4190,0x6B6B51F4,0x4DB26158,0x5005713C,
+    0xEDB88320,0xF00F9344,0xD6D6A3E8,0xCB61B38C,
+    0x9B64C2B0,0x86D3D2D4,0xA00AE278,0xBDBDF21C
+};
+static u32 Get(const u8 *p)
+{
+    return p[0] | ((u32)p[1]<<8) | ((u32)p[2]<<16) | ((u32)p[3]<<24);
+}
+static void Put(u8 *p, u32 n)
+{
+    p[0]=n;p[1]=n>>8;p[2]=n>>16;p[3]=n>>24;
+}
+static u32 Crc(const u8 *p)
+{
+    u16 i;
+    u32 crc=0xFFFFFFFF;
+    for(i=0;i<ATLAS_RECIPE_BYTES;i++)
+    {
+        crc ^= i>=28 && i<32 ? 0 : p[i];
+        crc=(crc>>4)^sCrc[crc&15];
+        crc=(crc>>4)^sCrc[crc&15];
+    }
+    return ~crc;
+}
+void AtlasRecipe_Reset(void)
+{
+    gAtlasRecipeStatus=0;gAtlasRecipeWrites=0;sExpectedPlan=sExpectedHabitat=0;
+}
+bool8 AtlasRecipe_Build(u8 *data,u32 counter)
+{
+    u16 i;
+    if(!data || !gAtlasPlanReady || gAtlasPlanStats.land==ATLAS_PLAN_COUNT)return FALSE;
+    memset(data,0,ATLAS_RECIPE_BYTES);
+    Put(data,0x41544C52);Put(data+4,1);Put(data+8,gAtlasWorldSeed);
+    Put(data+12,gAtlasPlanStats.checksum);Put(data+16,gAtlasPlanStats.habitatChecksum);
+    Put(data+20,counter);Put(data+24,ATLAS_GENERATION_VERSION);
+    Put(data+32,ATLAS_PLAN_WIDTH|((u32)ATLAS_PLAN_HEIGHT<<16));
+    for(i=0;i<ATLAS_PLAN_COUNT;i++)data[ATLAS_RECIPE_HEADER+i]=gAtlasPlan[i].height;
+    Put(data+28,Crc(data));
+    return TRUE;
+}
+bool8 AtlasRecipe_Valid(const u8 *data)
+{
+    u16 i;
+    if(!data || Get(data)!=0x41544C52 || Get(data+4)!=1
+        || Get(data+24)!=ATLAS_GENERATION_VERSION
+        || Get(data+32)!=(ATLAS_PLAN_WIDTH|((u32)ATLAS_PLAN_HEIGHT<<16))
+        || Get(data+28)!=Crc(data))return FALSE;
+    for(i=36;i<ATLAS_RECIPE_HEADER;i++)if(data[i])return FALSE;
+    for(i=ATLAS_RECIPE_HEADER+ATLAS_PLAN_COUNT;i<ATLAS_RECIPE_BYTES;i++)if(data[i])return FALSE;
+    return TRUE;
+}
+bool8 AtlasRecipe_Load(u32 seed)
+{
+    u8 slot,best=2;
+    u32 newest=0,counter;
+    u8 *data=AllocZeroed(ATLAS_RECIPE_BYTES);
+    if(!data)return FALSE;
+    for(slot=0;slot<2;slot++)
+        if(AtlasRecipeIO_Read(slot,data) && AtlasRecipe_Valid(data) && Get(data+8)==seed)
+        {
+            counter=Get(data+20);
+            if(best==2 || (s32)(counter-newest)>0){best=slot;newest=counter;}
+        }
+    if(best<2 && AtlasRecipeIO_Read(best,data) && AtlasRecipe_Valid(data)
+        && Get(data+8)==seed && AtlasPlan_ImportHeights(data+ATLAS_RECIPE_HEADER))
+    {
+        sExpectedPlan=Get(data+12);sExpectedHabitat=Get(data+16);
+        gAtlasRecipeStatus=1;Free(data);return TRUE;
+    }
+    Free(data);return FALSE;
+}
+bool8 AtlasRecipe_VerifyRestore(void)
+{
+    if(gAtlasRecipeStatus!=1)return TRUE;
+    if(gAtlasPlanStats.checksum==sExpectedPlan && gAtlasPlanStats.habitatChecksum==sExpectedHabitat)
+    {gAtlasRecipeStatus=2;return TRUE;}
+    gAtlasRecipeStatus=3;return FALSE;
+}
+void AtlasRecipe_Save(u32 counter)
+{
+    u8 slot,target=0;
+    u16 i;
+    bool8 valid[2];
+    u32 counters[2];
+    u8 *data;
+    if(!gAtlasPlanReady || gAtlasPlanStats.land==ATLAS_PLAN_COUNT)return;
+    data=AllocZeroed(ATLAS_RECIPE_BYTES);
+    if(!data){gAtlasRecipeStatus=6;return;}
+    for(slot=0;slot<2;slot++)
+    {
+        valid[slot]=AtlasRecipeIO_Read(slot,data) && AtlasRecipe_Valid(data);
+        counters[slot]=valid[slot]?Get(data+20):0;
+        if(valid[slot] && Get(data+8)==gAtlasWorldSeed)
+        {
+            for(i=0;i<ATLAS_PLAN_COUNT;i++)
+                if(data[ATLAS_RECIPE_HEADER+i]!=gAtlasPlan[i].height)break;
+            if(i==ATLAS_PLAN_COUNT && Get(data+12)==gAtlasPlanStats.checksum
+                && Get(data+16)==gAtlasPlanStats.habitatChecksum)
+            {gAtlasRecipeStatus=5;Free(data);return;}
+            valid[slot]=FALSE;
+        }
+    }
+    if(valid[0])target=!valid[1] || (s32)(counters[0]-counters[1])>=0?1:0;
+    if(AtlasRecipe_Build(data,counter) && AtlasRecipeIO_Write(target,data))
+    {gAtlasRecipeStatus=4;gAtlasRecipeWrites++;}
+    else gAtlasRecipeStatus=6;
+    Free(data);
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_recipe_flash.c b/implementation/engine/pokeemerald/src/atlas_recipe_flash.c
new file mode 100644
index 0000000000000000000000000000000000000000..160bb9379078b2e6f9e7a4e483394e24f1582d48
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_recipe_flash.c
@@ -0,0 +1,45 @@
+#include "global.h"
+#include "atlas_recipe.h"
+#include "agb_flash.h"
+#include "gba/flash_internal.h"
+#include "save.h"
+#include "load_save.h"
+
+/* Only Atlas's optional sectors 28..31. The normal two 14-sector player slots
+ * and Pokemon Storage are never addressed here. Commit the first sector last. */
+#define RECIPE_SIGNATURE 0x41545243
+bool8 AtlasRecipeIO_Read(u8 slot,u8 *data)
+{
+    u8 part,marker;
+    if(slot>1 || !data || !gFlashMemoryPresent)return FALSE;
+    for(part=0;part<2;part++)
+    {
+        u16 sector=28+slot*2+part;
+        ReadFlash(sector,SECTOR_SIZE-12,(u8 *)&gSaveDataBuffer.id,12);
+        marker=((u8 *)&gSaveDataBuffer)[SECTOR_SIZE-1];
+        if(gSaveDataBuffer.id!=0xA700+part || gSaveDataBuffer.signature!=RECIPE_SIGNATURE
+            || (!part && marker!=0xA5))return FALSE;
+        ReadFlash(sector,0,data+part*SECTOR_DATA_SIZE,SECTOR_DATA_SIZE);
+    }
+    return TRUE;
+}
+bool8 AtlasRecipeIO_Write(u8 slot,const u8 *data)
+{
+    s16 part;
+    u8 marker;
+    u16 sector;
+    if(slot>1 || !data || !gFlashMemoryPresent)return FALSE;
+    for(part=1;part>=0;part--)
+    {
+        sector=28+slot*2+part;
+        memset(&gSaveDataBuffer,0xFF,sizeof(gSaveDataBuffer));
+        memcpy(gSaveDataBuffer.data,data+part*SECTOR_DATA_SIZE,SECTOR_DATA_SIZE);
+        gSaveDataBuffer.id=0xA700+part;
+        gSaveDataBuffer.signature=RECIPE_SIGNATURE;
+        if(ProgramFlashSectorAndVerify(sector,(u8 *)&gSaveDataBuffer))return FALSE;
+    }
+    sector=28+slot*2;
+    if(ProgramFlashByte(sector,SECTOR_SIZE-1,0xA5))return FALSE;
+    ReadFlash(sector,SECTOR_SIZE-1,&marker,1);
+    return marker==0xA5;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_stream.c b/implementation/engine/pokeemerald/src/atlas_stream.c
new file mode 100644
index 0000000000000000000000000000000000000000..11aab510053d1c367312eed123c3faff39b7d5a9
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_stream.c
@@ -0,0 +1,266 @@
+#include "global.h"
+#include "atlas_world.h"
+
+/* One world-coordinate ring replaces three independently generated chunks.
+ * 9,604 bytes: final/native entries and compact geographic semantics.
+ * Only the off-screen apron can be pending; an incoming camera strip must be
+ * ready before a new step starts. No whole terrain fill on a warm rebase. */
+#define SIDE 49
+#define HALF 24
+#define SAMPLED 0x4000
+#define READY 0x8000
+EWRAM_DATA static u16 sEntries[SIDE * SIDE] = {0};
+EWRAM_DATA static u16 sSemantics[SIDE * SIDE] = {0};
+EWRAM_DATA u32 gAtlasCacheHits = 0;
+EWRAM_DATA u32 gAtlasCacheMisses = 0;
+EWRAM_DATA u32 gAtlasStreamWaits = 0;
+EWRAM_DATA static s32 sX = 0, sY = 0, sCenterX = 0, sCenterY = 0, sMapX = 0, sMapY = 0;
+EWRAM_DATA static u16 *sMap = NULL;
+EWRAM_DATA static u8 sPX = 0, sPY = 0, sEdge = 0;
+EWRAM_DATA static u16 sAt = 0;
+EWRAM_DATA static s32 sLeft = 0, sRight = 0, sTop = 0, sBottom = 0;
+EWRAM_DATA static bool8 sActive = 0;
+static s32 Unwrap(s32 x)
+{
+    if (x - sCenterX > ATLAS_WORLD_WIDTH / 2) x -= ATLAS_WORLD_WIDTH;
+    if (x - sCenterX < -ATLAS_WORLD_WIDTH / 2) x += ATLAS_WORLD_WIDTH;
+    return x;
+}
+static void CanonicalizeX(void)
+{
+    s32 offset;
+    if (sCenterX >= 0 && sCenterX < ATLAS_WORLD_WIDTH) return;
+    /* Keep keys near the canonical planet after each seam crossing. Moving
+     * the keys together preserves physical slots and unfinished frontier
+     * work, and prevents coordinates accumulating across repeated laps. */
+    offset = sCenterX < 0 ? -ATLAS_WORLD_WIDTH : ATLAS_WORLD_WIDTH;
+    sCenterX -= offset; sX -= offset; sMapX -= offset;
+    sLeft -= offset; sRight -= offset;
+}
+static s32 Index(s32 x, s32 y)
+{
+    s32 dx = x - sX, dy = y - sY;
+    if (dx < 0 || dx >= SIDE || dy < 0 || dy >= SIDE) return -1;
+    dx += sPX; if (dx >= SIDE) dx -= SIDE;
+    dy += sPY; if (dy >= SIDE) dy -= SIDE;
+    return dy * SIDE + dx;
+}
+static bool8 IsReady(s32 x, s32 y)
+{
+    s32 i = Index(x,y);
+    return i >= 0 && (sEntries[i] & READY);
+}
+static void Render(s32 x, s32 y)
+{
+    s32 index = Index(x,y), dx,dy,i,col,row,c,r;
+    u16 cells[9], entry, center;
+    if (index < 0 || !(sEntries[index] & SAMPLED) || (sEntries[index] & READY)) return;
+    if(x<=sX || x>=sX+SIDE-1 || y<=sY || y>=sY+SIDE-1)return;
+    entry=sEntries[index]&0x3FFF;
+    center=sSemantics[index];
+    /* Flat dry floors and unmarked connector floors do not inspect neighbors
+     * in AtlasTiles_Render. Water, raised non-connectors and potentially
+     * marked connector variants still need their full semantic stencil. */
+    if((center&3) || ((center&0x80)?(entry&3):(center&0x70)))
+    {
+        col=sPX+x-sX;if(col>=SIDE)col-=SIDE;
+        row=sPY+y-sY;if(row>=SIDE)row-=SIDE;
+        for (dy=-1;dy<=1;dy++)
+        {
+            r=row+dy;if(r<0)r+=SIDE;else if(r>=SIDE)r-=SIDE;
+            for(dx=-1;dx<=1;dx++)
+            {
+                c=col+dx;if(c<0)c+=SIDE;else if(c>=SIDE)c-=SIDE;
+                i=r*SIDE+c;
+                if(!(sEntries[i]&SAMPLED))return;
+                cells[(dy+1)*3+dx+1]=sSemantics[i];
+            }
+        }
+        entry=AtlasTiles_Render(entry,cells);
+    }
+    sEntries[index]=entry|SAMPLED|READY;
+    if(sMap && x>=sMapX && x<sMapX+35 && y>=sMapY && y<sMapY+34)
+        sMap[(y-sMapY)*35+x-sMapX]=entry;
+}
+void AtlasStream_Reset(void)
+{
+    memset(sEntries, 0, sizeof(sEntries));
+    sActive = FALSE; sMap = NULL; sPX = sPY = 0; sEdge = 4; sAt = 0;
+    gAtlasCacheHits = gAtlasCacheMisses = gAtlasStreamWaits = 0;
+}
+static void Cold(s32 x,s32 y)
+{
+    s32 dx,dy,index=0;
+    u16 floor;
+    memset(sEntries, 0, sizeof(sEntries)); sPX = sPY = 0;
+    sCenterX = x; sCenterY = y; sX = x-HALF; sY = y-HALF;
+    for (dy=0;dy<SIDE;dy++) for(dx=0;dx<SIDE;dx++,index++)
+    {
+        sSemantics[index] = AtlasTiles_Describe(sX+dx,sY+dy,&floor);
+        sEntries[index] = floor | SAMPLED;
+    }
+    sMap = NULL;
+    for(dy=1;dy<SIDE-1;dy++)for(dx=1;dx<SIDE-1;dx++)Render(sX+dx,sY+dy);
+    sLeft=sX;sRight=sX+SIDE;sTop=sY;sBottom=sY+SIDE;
+    sEdge=4;sAt=0;sActive=TRUE;
+}
+bool8 AtlasStream_Load(u16 *map, s32 x, s32 y)
+{
+    s32 dx,dy,bx,row,col,left,right,worldY;
+    u16 *source,*end;
+    u16 value;
+    if (!map || y < -ATLAS_WORLD_HALF_HEIGHT/20 || y >= ATLAS_WORLD_HALF_HEIGHT/20) return FALSE;
+    x %= ATLAS_WORLD_WIDTH/20; if(x<0)x+=ATLAS_WORLD_WIDTH/20;
+    bx = sActive ? Unwrap(x*20) : x*20;
+    if (!sActive || bx+10-sCenterX > 40 || bx+10-sCenterX < -40 || y*20+10-sCenterY > 40 || y*20+10-sCenterY < -40)
+    { Cold(bx+10,y*20+10); gAtlasCacheMisses++; }
+    else gAtlasCacheHits++;
+    sMap = map; sMapX = bx-7; sMapY = y*20-7;
+    left=sMapX<sX?sX-sMapX:0;
+    right=sX+SIDE-sMapX;if(right>35)right=35;
+    for(dy=0;dy<34;dy++)
+    {
+        worldY=sMapY+dy-sY;
+        if(worldY<0 || worldY>=SIDE || left>=right)
+        {for(dx=0;dx<35;dx++)map[dy*35+dx]=0x3401;continue;}
+        row=sPY+worldY;if(row>=SIDE)row-=SIDE;
+        col=sPX+sMapX+left-sX;if(col>=SIDE)col-=SIDE;
+        source=sEntries+row*SIDE+col;end=sEntries+(row+1)*SIDE;
+        for(dx=0;dx<left;dx++)map[dy*35+dx]=0x3401;
+        for(;dx<right;dx++)
+        {
+            value=*source++;if(source==end)source-=SIDE;
+            map[dy*35+dx]=(value&READY)?value&0x3FFF:0x3401;
+        }
+        for(;dx<35;dx++)map[dy*35+dx]=0x3401;
+    }
+    return TRUE;
+}
+static void Shift(s32 x,s32 y)
+{
+    s32 i, col, row;
+    while(sX < x-HALF)
+    {
+        for(i=0;i<SIDE;i++)sEntries[i*SIDE+sPX]=0;
+        if(++sPX==SIDE)sPX=0;
+        sX++;
+    }
+    while(sX > x-HALF)
+    {
+        if(!sPX)sPX=SIDE;
+        sPX--; sX--;
+        for(i=0;i<SIDE;i++)sEntries[i*SIDE+sPX]=0;
+    }
+    while(sY < y-HALF)
+    {
+        row=sPY*SIDE;for(i=0;i<SIDE;i++)sEntries[row+i]=0;
+        if(++sPY==SIDE)sPY=0;
+        sY++;
+    }
+    while(sY > y-HALF)
+    {
+        if(!sPY)sPY=SIDE;
+        sPY--;sY--;
+        row=sPY*SIDE;for(col=0;col<SIDE;col++)sEntries[row+col]=0;
+    }
+    sCenterX=x;sCenterY=y;sEdge=4;sAt=0;
+    if(sLeft<sX)sLeft=sX;
+    if(sRight>sX+SIDE)sRight=sX+SIDE;
+    if(sTop<sY)sTop=sY;
+    if(sBottom>sY+SIDE)sBottom=sY+SIDE;
+}
+static bool8 Job(s32 *x,s32 *y)
+{
+    s32 distance=0x7FFFFFFF;
+    if(sEdge==4)
+    {
+        if(sLeft>sX){distance=sCenterX-sLeft;sEdge=0;}
+        if(sRight<sX+SIDE && sRight-sCenterX<distance){distance=sRight-sCenterX;sEdge=1;}
+        if(sTop>sY && sCenterY-sTop<distance){distance=sCenterY-sTop;sEdge=2;}
+        if(sBottom<sY+SIDE && sBottom-sCenterY<distance)sEdge=3;
+        sAt=0;
+    }
+    if(sEdge==4)return FALSE;
+    if(sEdge<2){*x=sEdge?sRight:sLeft-1;*y=sTop+sAt;}
+    else{*x=sLeft+sAt;*y=sEdge==2?sTop-1:sBottom;}
+    return TRUE;
+}
+static void Advance(void)
+{
+    if(++sAt < (sEdge<2?sBottom-sTop:sRight-sLeft))return;
+    if(sEdge==0)sLeft--;
+    if(sEdge==1)sRight++;
+    if(sEdge==2)sTop--;
+    if(sEdge==3)sBottom++;
+    sEdge=4;sAt=0;
+}
+void AtlasStream_Tick(s32 x,s32 y,s32 localX,s32 localY)
+{
+    s32 wx,wy,index,dx,dy;
+    s64 rawX,rawY;
+    u16 floor;
+    u8 work=8;
+    if(!sActive)return;
+
+    /* Saved chunk coordinates can be malformed after a failed restore.
+     * Load rejects out-of-range latitude; Tick must not bypass that gate. */
+    if(y < -ATLAS_WORLD_HALF_HEIGHT/ATLAS_CHUNK_SIZE ||
+       y >= ATLAS_WORLD_HALF_HEIGHT/ATLAS_CHUNK_SIZE)return;
+    x %= ATLAS_WORLD_WIDTH/ATLAS_CHUNK_SIZE;
+    if(x < 0)x += ATLAS_WORLD_WIDTH/ATLAS_CHUNK_SIZE;
+
+    /* Widen before composing saved chunk and local position. A corrupted
+     * local position must not overflow Unwrap or drive a huge Shift loop. */
+    rawX=(s64)x*ATLAS_CHUNK_SIZE+localX;
+    rawY=(s64)y*ATLAS_CHUNK_SIZE+localY;
+    if(rawX < -ATLAS_CHUNK_SIZE ||
+       rawX > ATLAS_WORLD_WIDTH+ATLAS_CHUNK_SIZE ||
+       rawY < -ATLAS_WORLD_HALF_HEIGHT-ATLAS_CHUNK_SIZE ||
+       rawY > ATLAS_WORLD_HALF_HEIGHT+ATLAS_CHUNK_SIZE)return;
+    wx=Unwrap((s32)rawX);wy=(s32)rawY;
+
+    /* A valid warm camera rebase is at most 40 tiles from its center.
+     * Large jumps must go through Load's bounded cold path, not Shift's
+     * per-tile while loops (which can otherwise run millions of times). */
+    if(wx-sCenterX > 40 || wx-sCenterX < -40 ||
+       wy-sCenterY > 40 || wy-sCenterY < -40)return;
+    if(wx!=sCenterX || wy!=sCenterY)Shift(wx,wy);
+    CanonicalizeX();
+    while(work && Job(&wx,&wy))
+    {
+        index=Index(wx,wy);
+        if(!(sEntries[index]&SAMPLED))
+        {
+            work--;
+            if(!AtlasWater_Prewarm(wx,wy))continue;
+            sSemantics[index]=AtlasTiles_Describe(wx,wy,&floor);
+            sEntries[index]=floor|SAMPLED;
+            for(dy=-1;dy<=1;dy++)for(dx=-1;dx<=1;dx++)Render(wx+dx,wy+dy);
+        }
+        Advance();
+    }
+}
+bool8 AtlasStream_CanStep(u8 direction)
+{
+    s32 i,x=sCenterX,y=sCenterY;
+    if(!sActive || !direction)return TRUE;
+    /* Camera apron may be READY outside the physical latitude domain.
+     * It must never authorize an outward player step at either pole. */
+    if((direction==1 && y>=ATLAS_WORLD_HALF_HEIGHT-1) ||
+       (direction==2 && y<=-ATLAS_WORLD_HALF_HEIGHT))return FALSE;
+    if(direction==1)y++;
+    if(direction==2)y--;
+    if(direction==3)x--;
+    if(direction==4)x++;
+    if(direction==1 || direction==2)
+    {
+        y+=direction==1?8:-8;
+        for(i=-10;i<=10;i++)if(!IsReady(x+i,y)){gAtlasStreamWaits++;return FALSE;}
+    }
+    else
+    {
+        x+=direction==4?10:-10;
+        for(i=-8;i<=8;i++)if(!IsReady(x,y+i)){gAtlasStreamWaits++;return FALSE;}
+    }
+    return TRUE;
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_terrain.c b/implementation/engine/pokeemerald/src/atlas_terrain.c
new file mode 100644
index 0000000000000000000000000000000000000000..9d9e95557a76a0c35f833b3e90f3ebd9e8569cef
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_terrain.c
@@ -0,0 +1,285 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_plan.h"
+#include "atlas_tiles.h"
+#include "constants/metatile_labels.h"
+
+/* Geographic generation 1 for box 3, not the missing historical generator. */
+struct NoiseCache {
+    s32 x0, x1, y0, y1;
+    s32 lastX, lastY;
+    u32 rawX, rawY, remX, remY;
+    u16 a, b, c, d;
+    bool8 valid;
+};
+EWRAM_DATA static struct NoiseCache sNoise[9] = {{0}};
+void AtlasTerrain_SetSeed(u32 seed)
+{
+    gAtlasWorldSeed = seed;
+    memset(sNoise, 0, sizeof(sNoise));
+    AtlasTiles_Reset();
+    AtlasPlan_ResetSample();
+}
+static const s32 sScales[9] = {2000000, 350000, 160000, 14000, 600000, 1200, 96, 128, 1024};
+s32 AtlasTerrain_FloorDiv(s32 n, s32 d)
+{
+    s32 q = n / d;
+    return n % d < 0 ? q - 1 : q;
+}
+static s32 Wrap(s32 n)
+{
+    n %= ATLAS_WORLD_WIDTH;
+    return n < 0 ? n + ATLAS_WORLD_WIDTH : n;
+}
+static u32 Hash(s32 x, s32 y, u32 salt)
+{
+    u32 h = gAtlasWorldSeed ^ salt ^ (u32)x * 0x9E3779B1u ^ (u32)y * 0x85EBCA77u;
+    h ^= h >> 16; h *= 0x7FEB352Du;
+    h ^= h >> 15; h *= 0x846CA68Bu;
+    return h ^ (h >> 16);
+}
+static u32 Smooth(u32 f) { return (f * f * (768 - 2 * f)) >> 16; }
+static s32 Noise(s32 x, s32 y, u32 channel)
+{
+    struct NoiseCache *n = &sNoise[channel];
+    s32 scale = sScales[channel];
+    u32 fx, fy, top, bottom;
+    if (!n->valid || x < n->x0 || x >= n->x1 || y < n->y0 || y >= n->y1)
+    {
+        s32 gx = x / scale, gy = AtlasTerrain_FloorDiv(y, scale), next;
+        n->x0 = gx * scale; n->x1 = n->x0 + scale;
+        if (n->x1 > ATLAS_WORLD_WIDTH) n->x1 = ATLAS_WORLD_WIDTH;
+        n->y0 = gy * scale; n->y1 = n->y0 + scale;
+        next = n->x1 == ATLAS_WORLD_WIDTH ? 0 : gx + 1;
+        n->a = Hash(gx, gy, channel + 1) & 255;
+        n->b = Hash(next, gy, channel + 1) & 255;
+        n->c = Hash(gx, gy + 1, channel + 1) & 255;
+        n->d = Hash(next, gy + 1, channel + 1) & 255;
+        n->lastX = -2; n->lastY = -0x7FFFFFFF;
+        n->rawX = n->rawY = n->remX = n->remY = 0;
+        n->valid = TRUE;
+    }
+    if (x == n->lastX + 1)
+    {
+        n->remX += 256;
+        while (n->remX >= (u32)(n->x1 - n->x0)) { n->rawX++; n->remX -= n->x1 - n->x0; }
+    }
+    else if (x != n->lastX)
+    {
+        u32 v = (u32)(x - n->x0) * 256;
+        n->rawX = v / (u32)(n->x1 - n->x0); n->remX = v - n->rawX * (n->x1 - n->x0);
+    }
+    if (y == n->lastY + 1)
+    {
+        n->remY += 256;
+        while (n->remY >= (u32)scale) { n->rawY++; n->remY -= scale; }
+    }
+    else if (y != n->lastY)
+    {
+        u32 v = (u32)(y - n->y0) * 256;
+        n->rawY = v / (u32)scale; n->remY = v - n->rawY * scale;
+    }
+    n->lastX = x; n->lastY = y;
+    fx = Smooth(n->rawX); fy = Smooth(n->rawY);
+    top = (n->a * (256 - fx) + n->b * fx) >> 8;
+    bottom = (n->c * (256 - fx) + n->d * fx) >> 8;
+    return (top * (256 - fy) + bottom * fy) >> 8;
+}
+static u8 Clamp(s32 n) { return n < 0 ? 0 : n > 255 ? 255 : n; }
+u8 AtlasTerrain_ReliefNoise(s32 x,s32 y,bool8 broad)
+{
+    return Noise(Wrap(x),y,broad?8:7);
+}
+u8 AtlasTerrain_GroundHeight(s32 x,s32 y,struct AtlasPlanSample *plan)
+{
+    x=Wrap(x);
+    if(y< -ATLAS_WORLD_HALF_HEIGHT)y= -ATLAS_WORLD_HALF_HEIGHT;
+    if(y>=ATLAS_WORLD_HALF_HEIGHT)y=ATLAS_WORLD_HALF_HEIGHT-1;
+    AtlasPlan_SampleDetail(x,y,plan);
+    return plan->lake?plan->height:Clamp(plan->height+(Noise(x,y,3)-128)/16);
+}
+void AtlasTerrain_Sample(s32 x, s32 y, struct AtlasCell *cell)
+{
+    s32 e, rain, vapor, ridge, t, m;
+    struct AtlasHabitat habitat;
+    u8 water = ATLAS_DRY, surface = 0;
+    if (!cell) return;
+    cell->valley = 255;
+    x = Wrap(x);
+    if (y < -ATLAS_WORLD_HALF_HEIGHT || y >= ATLAS_WORLD_HALF_HEIGHT)
+    {
+        memset(cell, 0, sizeof(*cell)); cell->moisture = cell->humidity = 255;
+        cell->biome = ATLAS_OCEAN; cell->waterform = ATLAS_SEA; return;
+    }
+    if (gAtlasPlanReady)
+    {
+        struct AtlasPlanSample plan;
+        AtlasPlan_SampleDetail(x,y,&plan);
+        e = plan.lake ? plan.height : Clamp(plan.height + (Noise(x,y,3)-128)/16);
+        rain = Clamp(plan.rain + (Noise(x, y, 4) - 128) / 8); vapor = plan.humidity;
+        water = AtlasWater_Sample(x, y, e, &plan, &surface, &cell->valley);
+        if (water != ATLAS_DRY) e = surface;
+    }
+    else
+    {
+        e = (Noise(x, y, 0) * 3 + Noise(x, y, 1)) / 4;
+        ridge = Noise(x, y, 2) - 128;
+        if (ridge < 0) ridge = -ridge;
+        ridge = 255 - ridge * 2;
+        if (e > 132 && ridge > 140) e += (ridge - 140) * (e - 132) / 150;
+        e = Clamp(e + (Noise(x, y, 3) - 128) / 12);
+        rain = vapor = Noise(x, y, 4);
+        if (e < ATLAS_PLAN_SEA) water = ATLAS_SEA;
+    }
+    AtlasHabitat_Sample(y, e, rain, vapor, water, &habitat);
+    t = habitat.temperature; m = habitat.moisture;
+    cell->elevation = e; cell->temperature = t; cell->moisture = m;
+    cell->humidity = habitat.humidity; cell->seasonalRange = habitat.seasonalRange; cell->waterform = water;
+    cell->landform = e < 128 && e >= 121 ? ATLAS_COAST : e > 185 ? ATLAS_MOUNTAIN : e > 155 ? ATLAS_HILL : ATLAS_PLAIN;
+    if (water == ATLAS_SEA) cell->biome = ATLAS_OCEAN;
+    else if (water != ATLAS_DRY) cell->biome = ATLAS_WETLAND;
+    else if (t < 45) cell->biome = ATLAS_TUNDRA;
+    else if (t < 85) cell->biome = ATLAS_TAIGA;
+    else if (e < 132 && m > 160) cell->biome = ATLAS_WETLAND;
+    else if (t > 160 && m < 98) cell->biome = ATLAS_DESERT;
+    else if (t > 175 && m > 155) cell->biome = ATLAS_JUNGLE;
+    else if (m > 132) cell->biome = ATLAS_FOREST;
+    else if (t > 150 && m < 125) cell->biome = ATLAS_SAVANNA;
+    else cell->biome = ATLAS_GRASSLAND;
+}
+
+u16 AtlasTerrain_BaseTile(s32 x, s32 y, const struct AtlasCell *c, bool8 clearCover)
+{
+    u16 id;
+    u32 detail;
+    u8 variant;
+    if (c->waterform != ATLAS_DRY)
+        return PACK_METATILE(AtlasTiles_Water(255, 0, c->waterform)) | PACK_COLLISION(1) | PACK_ELEVATION(3);
+    x = Wrap(x);
+    /* Stateless coordinate detail; no new lattice, cache or geographic query.
+     * The source's three tuft variants share the same flat grass/snow border. */
+    detail = Hash(x, y, 0x47524E44);
+    variant = (detail & 15) < 4 ? detail & 3 : 0;
+    id = ATLAS_NATURE_GRASS_FIRST + variant;
+    if (c->biome == ATLAS_TUNDRA) id = ATLAS_NATURE_SNOW_FIRST + variant;
+    else if (c->biome == ATLAS_DESERT || c->landform == ATLAS_COAST) id = 0x124; /* Native sand behavior. */
+    else if (!clearCover && (c->biome == ATLAS_JUNGLE || c->biome == ATLAS_FOREST || c->biome == ATLAS_TAIGA || c->biome == ATLAS_GRASSLAND))
+    {
+        s32 threshold = c->biome == ATLAS_JUNGLE ? 125 : c->biome == ATLAS_TAIGA ? 165 : c->biome == ATLAS_FOREST ? 145 : 160;
+        /* Reuse the existing 96-tile cover field. Coordinate dither breaks
+         * solid rectangles inside a coherent patch, rather than filling a
+         * whole local ridge with native encounter-grass artwork. */
+        if (Noise(x, y, 6) > threshold + (s32)((detail >> 4) & 31)) id = METATILE_General_TallGrass;
+    }
+    else if (!clearCover && c->biome == ATLAS_WETLAND)
+    {
+        if ((detail & 7) < 5) id = METATILE_General_TallGrass;
+    }
+    else if (!clearCover && c->biome == ATLAS_SAVANNA && Noise(x, y, 6) < 85) id = 0x124;
+
+    return PACK_METATILE(id) | PACK_ELEVATION(3);
+}
+u16 AtlasTerrain_Tile(s32 x, s32 y)
+{
+    struct AtlasCell c;
+    AtlasTerrain_Sample(x, y, &c);
+    return AtlasTiles_At(x, y, &c);
+}
+bool8 AtlasTerrain_Fill(u16 *map, s32 width, s32 height, s32 chunkX, s32 chunkY)
+{
+    s32 y, bx, by;
+    if (!map || width != 35 || height != 34
+        || chunkX < -ATLAS_WORLD_WIDTH / 20 || chunkX >= ATLAS_WORLD_WIDTH / 20
+        || chunkY < -ATLAS_WORLD_HALF_HEIGHT / 20 || chunkY >= ATLAS_WORLD_HALF_HEIGHT / 20)
+        return FALSE;
+    bx = chunkX * 20 - 7; by = chunkY * 20 - 7;
+    for (y = 0; y < height; y++)
+        AtlasTiles_FillRow(map + y * width, bx, by + y, width);
+    return TRUE;
+}
+bool8 AtlasTerrain_FindSpawn(s32 *x, s32 *y)
+{
+    s32 i, dx, dy, wx, wy;
+    if (!x || !y) return FALSE;
+    /* Prefer existing riverbanks so the new geography can be inspected on foot. */
+    if (gAtlasPlanReady)
+    {
+        /* Normalize the seed offset before adding i: u32 wrap would skip nodes.
+         * The bounded index is a full permutation of the 96x48 plan. */
+        u16 start = Hash(0,0,123) % ATLAS_PLAN_COUNT;
+        for (i = 0; i < ATLAS_PLAN_COUNT; i++)
+        {
+            u16 node = (i + start) % ATLAS_PLAN_COUNT;
+            u16 width, level; s32 ax,ay,bx,by;
+            if (gAtlasPlan[node].height < ATLAS_PLAN_SEA || gAtlasPlan[node].runoff < 600 || gAtlasPlan[node].runoff > 6000) continue;
+            /* AtlasWater_Point reads the parent node; skip malformed plan links. */
+            if (gAtlasPlan[node].parent >= ATLAS_PLAN_COUNT) continue;
+            width = 24 + gAtlasPlan[node].runoff / 128; if (width > 400) width = 400;
+            AtlasWater_Point(node,1,&ax,&ay,&level); AtlasWater_Point(node,3,&bx,&by,&level);
+            {
+                struct AtlasCell cell; bool8 safe = TRUE;
+                AtlasWater_Point(node,2,&wx,&wy,&level);
+                if (bx - ax > by - ay && bx - ax > ay - by) wy += (width + 6);
+                else if (ax - bx > by - ay && ax - bx > ay - by) wy += (width + 6);
+                else wx += (width + 6);
+                wx = Wrap(wx); wx = AtlasTerrain_FloorDiv(wx,20)*20+10; wy = AtlasTerrain_FloorDiv(wy,20)*20+10;
+                AtlasTerrain_Sample(wx,wy,&cell);
+                if (cell.temperature < 85 || cell.waterform != ATLAS_DRY || cell.elevation > 185) continue;
+                for (dy=-4;dy<=4&&safe;dy++)for(dx=-4;dx<=4;dx++)
+                    if(AtlasTerrain_Tile(wx+dx,wy+dy)&0xC00){safe=FALSE;break;}
+                for(dx=0;dx<=25&&safe;dx++)if(AtlasTerrain_Tile(wx+dx,wy)&0xC00)safe=FALSE;
+                if(safe){*x=wx;*y=wy;return TRUE;}
+            }
+        }
+    }
+    for (i = 0; i < 4096; i++)
+    {
+        struct AtlasCell cell;
+        bool8 safe = TRUE;
+        wx = 33453850 + (i % 64) * 223; wy = 4307290 + (i / 64) * 197;
+        AtlasTerrain_Sample(wx, wy, &cell);
+        if (cell.biome == ATLAS_OCEAN || cell.biome == ATLAS_DESERT || cell.landform == ATLAS_MOUNTAIN) continue;
+        for (dy = -4; dy <= 4 && safe; dy++)
+            for (dx = -4; dx <= 4; dx++)
+                if (AtlasTerrain_Tile(wx + dx, wy + dy) & 0x0C00) { safe = FALSE; break; }
+        if (safe) { *x = wx; *y = wy; return TRUE; }
+    }
+    /* Global fallback surveys real land; no artificial starting terrain. */
+    for (i = 0; i < 4096; i++)
+    {
+        wx = (s32)(Hash(i, 0, 99) % ATLAS_WORLD_WIDTH);
+        wy = (s32)(Hash(i, 1, 99) % (2u * ATLAS_WORLD_HALF_HEIGHT)) - ATLAS_WORLD_HALF_HEIGHT;
+        {
+            bool8 safe = TRUE;
+            for (dy = -4; dy <= 4 && safe; dy++)
+                for (dx = -4; dx <= 4; dx++)
+                    if (AtlasTerrain_Tile(wx + dx, wy + dy) & 0x0C00) { safe = FALSE; break; }
+            if (safe) { *x = wx; *y = wy; return TRUE; }
+        }
+    }
+    return FALSE;
+}
+
+/* Terrain revisions can cover an old standing tile with a new small channel.
+ * Reject wet candidates with one sample instead of compiling nine neighbors. */
+bool8 AtlasTerrain_RepairLanding(s32 *x,s32 *y)
+{
+    s32 dx,dy,r,baseX; s64 yy; struct AtlasCell c;
+    if(!x || !y)return FALSE;
+    if(!(AtlasTerrain_Tile(*x,*y)&0xC00))return TRUE;
+    /* Normalize before adding the search offset: saved x may be extreme. */
+    baseX=Wrap(*x);
+    for(r=1;r<=32;r++)for(dy=-r;dy<=r;dy++)for(dx=-r;dx<=r;dx++)
+    {
+        if(dx!=-r && dx!=r && dy!=-r && dy!=r)continue;
+        /* Widen before addition; a malformed old latitude must not overflow. */
+        yy=(s64)*y+dy;
+        if(yy<=-ATLAS_WORLD_HALF_HEIGHT || yy>=ATLAS_WORLD_HALF_HEIGHT)continue;
+        AtlasTerrain_Sample(baseX+dx,(s32)yy,&c);
+        if(c.waterform || (AtlasTerrain_Tile(baseX+dx,(s32)yy)&0xC00))continue;
+        *x=Wrap(baseX+dx);*y=(s32)yy;return TRUE;
+    }
+    /* An isthmus can disappear into connected water on both sides. Prefer a
+     * verified spawn over leaving an older save immobilized inside that water. */
+    return AtlasTerrain_FindSpawn(x,y);
+}
diff --git a/implementation/engine/pokeemerald/src/atlas_tiles.c b/implementation/engine/pokeemerald/src/atlas_tiles.c
new file mode 100644
index 0000000000000000000000000000000000000000..8078ff0df84aebbd597780dd5491e1b3088d14dd
--- /dev/null
+++ b/implementation/engine/pokeemerald/src/atlas_tiles.c
@@ -0,0 +1,90 @@
+#include "global.h"
+#include "atlas_world.h"
+#include "atlas_tiles.h"
+#include "constants/metatile_labels.h"
+
+/* Compact semantics: geographic height, relief/pass, material and water type.
+ * The streaming cache owns persistence; direct queries use the same selector. */
+void AtlasTiles_Reset(void) {}
+u16 AtlasTiles_Water(u8 mask, u8 material, u8 waterform)
+{
+    return ATLAS_NATURE_WATER_FIRST + (waterform == ATLAS_SEA ? 188 : 0) + material * 47 + gAtlasNatureMaskIndex[mask];
+}
+static u8 Material(const struct AtlasCell *c)
+{
+    if (c->biome == ATLAS_TUNDRA) return 3;
+    if (c->elevation > 205) return 2;
+    if (c->biome == ATLAS_DESERT || c->landform == ATLAS_COAST) return 1;
+    return 0;
+}
+static u16 Describe(s32 x, s32 y, const struct AtlasCell *c, u16 *floor)
+{
+    u8 relief = AtlasMountain_Relief(x, y, c);
+    *floor = AtlasTerrain_BaseTile(x, y, c, !!(relief & 0x80));
+    return ((u16)c->elevation << 8) | relief | (Material(c) << 2) | c->waterform;
+}
+u16 AtlasTiles_Describe(s32 x, s32 y, u16 *floor)
+{
+    struct AtlasCell c;
+    AtlasTerrain_Sample(x, y, &c);
+    return Describe(x, y, &c, floor);
+}
+u16 AtlasTiles_Render(u16 floor, const u16 *cells)
+{
+    static const u8 neighbors[8] = {1,5,7,3,2,8,6,0};
+    u16 center = cells[4];
+    u8 water = center & 3, tier = (center >> 4) & 7;
+    u8 i, mask = 0, material = 0, count[4] = {0};
+    if (!water)
+    {
+        if (center & 0x80)
+        {
+            /* Mark only a connector crossing a terrace change. Flat valley
+             * reservations and broad saddle interiors keep their own floor.
+             * Reuse sparse floor variants to avoid an artificial dotted line
+             * around every contour. Tall grass retains its ground cover.
+             * This reads the prepared neighborhood; no terrain resampling. */
+            if (!(floor & 3) || (floor & 1023) == METATILE_General_TallGrass) return floor;
+            for (i = 0; i < 8; i++)
+                if (!(cells[neighbors[i]] & 3) && ((cells[neighbors[i]] >> 4) & 7) != tier)
+                    return PACK_METATILE(ATLAS_NATURE_PASS_FIRST + (((center >> 2) & 3) == 3)
+                        + ((floor & 1) << 1)) | PACK_ELEVATION(3);
+            return floor;
+        }
+        if (!tier) return floor;
+        for (i = 0; i < 8; i++)
+        {
+            if (cells[neighbors[i]] & 3) return floor;
+            if (((cells[neighbors[i]] >> 4) & 7) >= tier) mask |= 1 << i;
+        }
+        if (mask == 255) return floor;
+        return PACK_METATILE(ATLAS_NATURE_MOUNTAIN_FIRST + (((center >> 2) & 3) == 3 ? 47 : 0) + gAtlasNatureMaskIndex[mask]) | PACK_COLLISION(1) | PACK_ELEVATION(3);
+    }
+    for (i = 0; i < 8; i++)
+        if (cells[neighbors[i]] & 3) mask |= 1 << i;
+        else count[(cells[neighbors[i]] >> 2) & 3]++;
+    for (i = 1; i < 4; i++) if (count[i] > count[material]) material = i;
+    return PACK_METATILE(AtlasTiles_Water(mask, material, water)) | PACK_COLLISION(1) | PACK_ELEVATION(3);
+}
+u16 AtlasTiles_At(s32 x, s32 y, const struct AtlasCell *center)
+{
+    u16 cells[9], floor, ignored;
+    s32 dx, dy;
+    for (dy = -1; dy <= 1; dy++) for (dx = -1; dx <= 1; dx++)
+        if (!dx && !dy) cells[4] = Describe(x, y, center, &floor);
+        else cells[(dy + 1) * 3 + dx + 1] = AtlasTiles_Describe(x + dx, y + dy, &ignored);
+    return AtlasTiles_Render(floor, cells);
+}
+void AtlasTiles_FillRow(u16 *dest, s32 x, s32 y, u16 width)
+{
+    u16 cells[3][37], floors[35], nine[9], ignored, col;
+    s32 dy, dx;
+    if (!dest || !width || width > 35) return;
+    for (dy = 0; dy < 3; dy++) for (col = 0; col < width + 2; col++)
+        cells[dy][col] = AtlasTiles_Describe(x + col - 1, y + dy - 1, dy == 1 && col && col <= width ? &floors[col - 1] : &ignored);
+    for (col = 0; col < width; col++)
+    {
+        for (dy = 0; dy < 3; dy++) for (dx = 0; dx < 3; dx++) nine[dy * 3 + dx] = cells[dy][col + dx];
+        dest[col] = AtlasTiles_Render(floors[col], nine);
+    }
+}
